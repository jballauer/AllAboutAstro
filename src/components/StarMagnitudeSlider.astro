---
import { Image } from 'astro:assets';

interface StarMarker {
  commonName: string | null;
  catalogName: string;
  mag: number;
  specType: string;
  x: number;
  y: number;
  // Optional label-only nudge (px, at the frame's natural render width) for
  // co-located stars whose tags would otherwise overlap. Shifts the tag box
  // and its leader together; the ring itself always stays exactly on the
  // star's real pixel position regardless of this offset.
  tagDx?: number;
  tagDy?: number;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  imageWidth: number;
  imageHeight: number;
  stars: StarMarker[];
  maxMag?: number;
}

const { image, alt, imageWidth, imageHeight, stars, maxMag = 10 } = Astro.props;
const ticks = Array.from({ length: maxMag + 1 }, (_, i) => i);
---

<div class="star-mag-slider">
  <div class="sms-frame">
    <Image src={image} alt={alt} width={imageWidth} height={imageHeight} />
    {stars.map((s) => (
      <span
        class="sms-marker"
        data-bucket={Math.ceil(s.mag)}
        style={`left:${((s.x / imageWidth) * 100).toFixed(2)}%; top:${((s.y / imageHeight) * 100).toFixed(2)}%`}
      >
        <span class="sms-dot"></span>
        <span class="sms-leader"></span>
        <span
          class="sms-tag"
          style={(s.tagDx || s.tagDy) ? `transform: translate(${s.tagDx ?? 0}px, ${s.tagDy ?? 0}px)` : undefined}
        >
          <strong>{s.commonName ?? s.catalogName}</strong>
          {s.commonName && <span class="sms-cat">{s.catalogName}</span>}
          <span class="sms-mag">mag {s.mag.toFixed(2)}</span>
          {s.specType && <span class="sms-sp">{s.specType}</span>}
        </span>
      </span>
    ))}
  </div>
  <div class="sms-controls">
    <input
      type="range"
      class="sms-input"
      min="0"
      max={maxMag}
      step="1"
      value="0"
      list="sms-ticks"
      aria-label="Show named stars down to this apparent magnitude"
    />
    <datalist id="sms-ticks">
      {ticks.map((t) => <option value={t}></option>)}
    </datalist>
    <div class="sms-readout">
      <span class="sms-readout-value">0 &mdash; normal image</span>
      <span class="sms-readout-count"></span>
    </div>
  </div>
</div>

<style>
  .star-mag-slider {
    margin: 0.3rem 0 1.5rem;
  }
  .sms-frame {
    position: relative;
  }
  .sms-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The marker's own left/top is the star's exact pixel (as a
     percentage) -- do NOT transform/center the whole dot+tag block on
     that point, or the tag ends up covering the star itself. Only
     horizontal centering is applied to the block; the ring's negative
     margin (below) pulls just the ring itself up so its center -- not
     the block's top edge -- lands exactly on the star. */
  .sms-marker {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  .sms-marker[data-visible='true'] {
    display: block;
  }
  /* Hollow ring, not a filled dot -- the star must stay visible through
     the middle even while marked/labeled. A gold ring alone all but
     disappears against a blown-out white/saturated star core, so it's
     outlined in black on both sides (a solid inset ring plus a solid
     outset ring via box-shadow) -- gold stays the primary color, but the
     black keeps the ring's edges visible against any background,
     saturated star or dark sky alike. */
  .sms-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px auto 0;
    border-radius: 50%;
    border: 1.5px solid #ffd54a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.9);
  }
  /* Short leader line from the ring down to the label, so the label can
     sit clear of the star instead of overlapping it. Always renders
     directly below the ring, unshifted -- an optional tagDx/tagDy (see
     .sms-tag below) moves only the tag box, never this stem, so the
     stem always visibly connects to its own ring instead of floating
     off toward a relocated tag. Same black-outline treatment as
     .sms-dot -- a bare 1px gold line gets lost crossing a
     bright/saturated part of the star or nebula, so it's flanked by a
     1px black edge on each side (a 3px black bar with the gold line
     centered on top), keeping it visible against any background. */
  .sms-leader {
    display: block;
    width: 1px;
    height: 7px;
    margin: 0 auto;
    background: rgba(255, 213, 74, 0.85);
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.85),
      1px 0 0 rgba(0, 0, 0, 0.85);
  }
  /* Optional inline transform (see the tagDx/tagDy handling in the
     template above) nudges just this box, for a colliding label on a
     genuine close pair -- the ring and leader above are unaffected, so
     the leader keeps pointing at the ring even when the tag itself has
     moved elsewhere. */
  .sms-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 213, 74, 0.55);
    border-radius: 3px;
    padding: 2px 5px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    color: #fff;
    pointer-events: none;
  }
  .sms-tag strong {
    font-size: 0.68rem;
  }
  .sms-cat {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
  }
  .sms-mag {
    color: #ffd54a;
  }
  .sms-sp {
    color: rgba(255, 255, 255, 0.65);
  }
  .sms-controls {
    max-width: 420px;
    margin: 0.75rem auto 0;
    text-align: center;
  }
  .sms-input {
    width: 100%;
  }
  .sms-readout {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-style: italic;
  }
  .sms-readout-count {
    opacity: 0.75;
  }
  .sms-readout-count:not(:empty)::before {
    content: ' \2014 ';
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.star-mag-slider').forEach((widget) => {
    const input = widget.querySelector<HTMLInputElement>('.sms-input')!;
    const markers = Array.from(widget.querySelectorAll<HTMLElement>('.sms-marker'));
    const valueEl = widget.querySelector('.sms-readout-value')!;
    const countEl = widget.querySelector('.sms-readout-count')!;

    function apply() {
      const value = Number(input.value);
      if (value === 0) {
        markers.forEach((m) => m.removeAttribute('data-visible'));
        valueEl.textContent = '0 — normal image';
        countEl.textContent = '';
        return;
      }
      let shown = 0;
      markers.forEach((m) => {
        const bucket = Number(m.dataset.bucket);
        if (bucket <= value) {
          m.setAttribute('data-visible', 'true');
          shown++;
        } else {
          m.removeAttribute('data-visible');
        }
      });
      valueEl.textContent = `Stars ≤ magnitude ${value}`;
      countEl.textContent = `${shown} labeled`;
    }

    input.addEventListener('input', apply);
    apply();
  });
</script>
