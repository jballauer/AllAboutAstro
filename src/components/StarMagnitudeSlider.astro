---
import { Image } from 'astro:assets';

interface StarMarker {
  commonName: string | null;
  catalogName: string;
  mag: number;
  specType: string;
  x: number;
  y: number;
  // Optional label-only nudge (px, at the frame's natural render width) for
  // co-located stars whose tags would otherwise overlap. Shifts the tag box
  // and its leader together; the ring itself always stays exactly on the
  // star's real pixel position regardless of this offset.
  tagDx?: number;
  tagDy?: number;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  imageWidth: number;
  imageHeight: number;
  stars: StarMarker[];
  maxMag?: number;
}

const { image, alt, imageWidth, imageHeight, stars, maxMag = 10 } = Astro.props;
const ticks = Array.from({ length: maxMag + 1 }, (_, i) => i);

// The leader must always point from the ring to wherever the tag actually
// ends up -- with no offset that's straight down (the historical fixed 7px
// stem), but once tagDx/tagDy relocates the tag sideways a vertical stem no
// longer reaches it and reads as disconnected. Compute the ring-to-tag
// vector at build time (dx, base-gap+dy) and rotate a bar to match, rather
// than hardcoding a vertical line.
const BASE_GAP = 7; // px, the ring-bottom-to-tag-top gap with no offset
function leaderGeometry(s: StarMarker) {
  const dx = s.tagDx ?? 0;
  const dy = BASE_GAP + (s.tagDy ?? 0);
  const length = Math.sqrt(dx * dx + dy * dy);
  const angleDeg = (Math.atan2(-dx, dy) * 180) / Math.PI;
  return { length, angleDeg };
}
---

<div class="star-mag-slider">
  <div class="sms-frame">
    <Image src={image} alt={alt} width={imageWidth} height={imageHeight} />
    {stars.map((s) => {
      const { length, angleDeg } = leaderGeometry(s);
      return (
        <span
          class="sms-marker"
          data-bucket={Math.ceil(s.mag)}
          style={`left:${((s.x / imageWidth) * 100).toFixed(2)}%; top:${((s.y / imageHeight) * 100).toFixed(2)}%`}
        >
          <span class="sms-dot"></span>
          <span
            class="sms-leader"
            style={`height:${length.toFixed(2)}px; transform: translate(-50%, 0) rotate(${angleDeg.toFixed(2)}deg);`}
          ></span>
          <span
            class="sms-tag"
            style={(s.tagDx || s.tagDy) ? `transform: translate(${s.tagDx ?? 0}px, ${s.tagDy ?? 0}px)` : undefined}
          >
            <strong>{s.commonName ?? s.catalogName}</strong>
            {s.commonName && <span class="sms-cat">{s.catalogName}</span>}
            <span class="sms-mag">mag {s.mag.toFixed(2)}</span>
            {s.specType && <span class="sms-sp">{s.specType}</span>}
          </span>
        </span>
      );
    })}
  </div>
  <div class="sms-controls">
    <input
      type="range"
      class="sms-input"
      min="0"
      max={maxMag}
      step="1"
      value="0"
      list="sms-ticks"
      aria-label="Show named stars down to this apparent magnitude"
    />
    <datalist id="sms-ticks">
      {ticks.map((t) => <option value={t}></option>)}
    </datalist>
    <div class="sms-readout">
      <span class="sms-readout-value">0 &mdash; normal image</span>
      <span class="sms-readout-count"></span>
    </div>
  </div>
</div>

<style>
  .star-mag-slider {
    margin: 0.3rem 0 1.5rem;
  }
  .sms-frame {
    position: relative;
  }
  .sms-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The marker's own left/top is the star's exact pixel (as a
     percentage) -- do NOT transform/center the whole dot+tag block on
     that point, or the tag ends up covering the star itself. Only
     horizontal centering is applied to the block; the ring's negative
     margin (below) pulls just the ring itself up so its center -- not
     the block's top edge -- lands exactly on the star. */
  .sms-marker {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  .sms-marker[data-visible='true'] {
    display: block;
  }
  /* Hollow ring, not a filled dot -- the star must stay visible through
     the middle even while marked/labeled. A gold ring alone all but
     disappears against a blown-out white/saturated star core, so it's
     outlined in black on both sides (a solid inset ring plus a solid
     outset ring via box-shadow) -- gold stays the primary color, but the
     black keeps the ring's edges visible against any background,
     saturated star or dark sky alike. */
  .sms-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px auto 0;
    border-radius: 50%;
    border: 1.5px solid #ffd54a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.9);
  }
  /* Leader line from the ring to the label. Anchored (via absolute
     positioning, not flow) at the ring's exact bottom edge -- local
     top:5px, since the ring's own -5px/auto/0 margin trick centers it on
     the star at local y:0, putting its bottom edge at y:+5. Height and
     rotation are set per-marker inline (see leaderGeometry() above): with
     no tagDx/tagDy the bar is a plain 7px vertical stem (angle 0), and
     with an offset it's rotated + lengthened to reach the tag's actual
     relocated position -- a fixed vertical stem can't do that, it just
     dangles disconnected from whichever direction the tag moved.
     transform-origin: top keeps the pivot at the ring end, not the
     middle, so the far end is what swings to meet the tag. Same
     black-outline treatment as .sms-dot -- a bare 1px gold line gets
     lost crossing a bright/saturated part of the star or nebula, so
     it's flanked by a 1px black edge on each side (box-shadow rotates
     with the element, so this still reads correctly at any angle). */
  .sms-leader {
    position: absolute;
    left: 50%;
    top: 5px;
    width: 1px;
    transform-origin: top center;
    background: rgba(255, 213, 74, 0.85);
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.85),
      1px 0 0 rgba(0, 0, 0, 0.85);
  }
  /* margin-top reproduces the same ring-to-tag gap the old flow-based
     leader used to provide implicitly (it's now position:absolute, out
     of flow, so this box no longer gets pushed down by it) -- must match
     leaderGeometry()'s BASE_GAP constant above. Optional inline transform
     (see the tagDx/tagDy handling in the template above) nudges just this
     box for a colliding label on a genuine close pair; the leader is
     recalculated to still reach it at any offset. */
  .sms-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 213, 74, 0.55);
    border-radius: 3px;
    padding: 2px 5px;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    color: #fff;
    pointer-events: none;
  }
  .sms-tag strong {
    font-size: 0.68rem;
  }
  .sms-cat {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
  }
  .sms-mag {
    color: #ffd54a;
  }
  .sms-sp {
    color: rgba(255, 255, 255, 0.65);
  }
  .sms-controls {
    max-width: 420px;
    margin: 0.75rem auto 0;
    text-align: center;
  }
  .sms-input {
    width: 100%;
  }
  .sms-readout {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-style: italic;
  }
  .sms-readout-count {
    opacity: 0.75;
  }
  .sms-readout-count:not(:empty)::before {
    content: ' \2014 ';
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.star-mag-slider').forEach((widget) => {
    const input = widget.querySelector<HTMLInputElement>('.sms-input')!;
    const markers = Array.from(widget.querySelectorAll<HTMLElement>('.sms-marker'));
    const valueEl = widget.querySelector('.sms-readout-value')!;
    const countEl = widget.querySelector('.sms-readout-count')!;

    function apply() {
      const value = Number(input.value);
      if (value === 0) {
        markers.forEach((m) => m.removeAttribute('data-visible'));
        valueEl.textContent = '0 — normal image';
        countEl.textContent = '';
        return;
      }
      let shown = 0;
      markers.forEach((m) => {
        const bucket = Number(m.dataset.bucket);
        if (bucket <= value) {
          m.setAttribute('data-visible', 'true');
          shown++;
        } else {
          m.removeAttribute('data-visible');
        }
      });
      valueEl.textContent = `Stars ≤ magnitude ${value}`;
      countEl.textContent = `${shown} labeled`;
    }

    input.addEventListener('input', apply);
    apply();
  });
</script>
