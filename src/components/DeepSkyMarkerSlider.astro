---
import { Image } from 'astro:assets';

interface DeepSkyMarker {
  catalogName: string;
  // Real apparent magnitude, when one exists. null for genuinely
  // diffuse/extended objects with no citable point magnitude (e.g. a star
  // cloud) -- pair with an explicit `bucket` in that case so it still has
  // a defined reveal position, just not one implying real photometry.
  mag: number | null;
  // Explicit reveal bucket, same units as `step`. Required when mag is
  // null; optional otherwise (defaults to the mag rounded up to the next
  // `step`) -- use it to force an object to appear alongside another
  // (e.g. co-locating a magnitude-less object with a real one).
  bucket?: number;
  // Short human-readable kind shown under the name (e.g. "Galaxy",
  // "Globular Cluster", "Star Cloud") -- optional, omit for a plain
  // single-line tag.
  kind?: string;
  x: number;
  y: number;
  // Optional label-only nudge (px, at the frame's natural render width) for
  // co-located markers whose tags would otherwise overlap. Shifts the tag
  // box and its leader together; the ring itself always stays exactly on
  // the marker's real pixel position regardless of this offset.
  tagDx?: number;
  tagDy?: number;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  imageWidth: number;
  imageHeight: number;
  markers: DeepSkyMarker[];
  // Bucket granularity -- 1 for a whole-magnitude spread (e.g. mag 2-10),
  // 0.1 for a tightly-clustered set (e.g. several objects all within one
  // whole magnitude of each other, where integer buckets would collapse
  // them into a single reveal step instead of staggering by real
  // brightness). Default 1.
  step?: number;
  // Slider floor/ceiling, in `step` units. Default: computed from the
  // markers' own buckets so the resting value shows nothing and the max
  // value shows everything.
  minMag?: number;
  maxMag?: number;
}

const {
  image,
  alt,
  imageWidth,
  imageHeight,
  markers,
  step = 1,
  minMag: minMagProp,
  maxMag: maxMagProp,
} = Astro.props;

const decimals = step < 1 ? String(step).split('.')[1]?.length ?? 1 : 0;
function roundUpToStep(value: number): number {
  // Small epsilon so a value that's already an exact multiple of `step`
  // (e.g. mag exactly 14.0 with step 1) rounds to itself, not the next
  // step up -- Math.ceil alone would push 14.0 to 15 due to how floating
  // point division can land a hair above the exact multiple.
  const raw = Math.ceil(value / step - 1e-9) * step;
  return Number(raw.toFixed(decimals));
}
function bucketOf(m: DeepSkyMarker): number {
  return m.bucket ?? roundUpToStep(m.mag!);
}

const buckets = markers.map(bucketOf);
// The resting value must be strictly below every marker's own bucket, so
// "at rest" is guaranteed to show zero markers -- not an accident of the
// data, an explicit floor.
const minMag = minMagProp ?? Number((Math.min(...buckets) - step).toFixed(decimals));
const maxMag = maxMagProp ?? Math.max(...buckets);
// Datalist tick marks are a visual aid only (the slider itself still
// moves in `step` increments) -- one per whole number in range keeps the
// control legible even when `step` is fractional and would otherwise
// imply dozens of ticks.
const tickStart = Math.floor(minMag);
const tickEnd = Math.ceil(maxMag);
const ticks = Array.from({ length: tickEnd - tickStart + 1 }, (_, i) => tickStart + i);

const RING_RADIUS = 5; // px, half of .dsm-dot's 10px diameter
const BASE_GAP = 7; // px, the ring-bottom-to-tag-top gap with no offset
const TAG_DEFAULT_Y = RING_RADIUS + BASE_GAP; // tag's default top-center y, from ring center
function leaderGeometry(m: DeepSkyMarker) {
  const dx = m.tagDx ?? 0;
  const targetX = dx;
  const targetY = TAG_DEFAULT_Y + (m.tagDy ?? 0);
  const anchorX = dx !== 0 ? Math.sign(dx) * RING_RADIUS : 0;
  const anchorY = dx !== 0 ? 0 : RING_RADIUS;
  const vx = targetX - anchorX;
  const vy = targetY - anchorY;
  const length = Math.sqrt(vx * vx + vy * vy);
  const angleDeg = (Math.atan2(-vx, vy) * 180) / Math.PI;
  return { length, angleDeg, anchorX, anchorY };
}
---

<div class="deep-sky-marker-slider">
  <div class="dsm-frame no-lightbox">
    <Image src={image} alt={alt} width={imageWidth} height={imageHeight} />
    {markers.map((m) => {
      const { length, angleDeg, anchorX, anchorY } = leaderGeometry(m);
      return (
        <span
          class="dsm-marker"
          data-bucket={bucketOf(m)}
          style={`left:${((m.x / imageWidth) * 100).toFixed(2)}%; top:${((m.y / imageHeight) * 100).toFixed(2)}%`}
        >
          <span class="dsm-dot"></span>
          <span
            class="dsm-leader"
            style={`left:calc(50% + ${anchorX}px); top:${anchorY}px; height:${length.toFixed(2)}px; transform: translate(-50%, 0) rotate(${angleDeg.toFixed(2)}deg);`}
          ></span>
          <span
            class="dsm-tag"
            style={(m.tagDx || m.tagDy) ? `transform: translate(${m.tagDx ?? 0}px, ${m.tagDy ?? 0}px)` : undefined}
          >
            <strong>{m.catalogName}</strong>
            {m.kind && <span class="dsm-kind">{m.kind}</span>}
            {m.mag != null && <span class="dsm-mag">mag {m.mag.toFixed(1)}</span>}
          </span>
        </span>
      );
    })}
  </div>
  <div class="dsm-controls">
    <input
      type="range"
      class="dsm-input"
      min={minMag}
      max={maxMag}
      step={step}
      value={minMag}
      list="dsm-ticks"
      aria-label="Reveal deep-sky objects down to this apparent magnitude"
    />
    <datalist id="dsm-ticks">
      {ticks.map((t) => <option value={t}></option>)}
    </datalist>
    <div class="dsm-readout">
      <span class="dsm-readout-value">Normal image</span>
      <span class="dsm-readout-count"></span>
    </div>
  </div>
</div>

<style>
  .deep-sky-marker-slider {
    margin: 0.3rem 0 1.5rem;
  }
  .dsm-frame {
    position: relative;
    cursor: default;
  }
  .dsm-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    cursor: default;
  }
  /* The marker's own left/top is the object's exact pixel (as a
     percentage) -- do NOT transform/center the whole dot+tag block on
     that point, or the tag ends up covering the object itself. Only
     horizontal centering is applied to the block; the ring's negative
     margin (below) pulls just the ring itself up so its center -- not
     the block's top edge -- lands exactly on the marked point. */
  .dsm-marker {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  .dsm-marker[data-visible='true'] {
    display: block;
  }
  /* Hollow ring, not a filled dot -- the underlying feature (galaxy core,
     nebulosity, faint point source) must stay visible through the middle
     even while marked/labeled. Same black-outline treatment as the star
     slider's ring, so it stays legible against a saturated core. */
  .dsm-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px auto 0;
    border-radius: 50%;
    border: 1.5px solid #ffd54a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.9);
  }
  .dsm-leader {
    position: absolute;
    width: 1px;
    transform-origin: top center;
    background: rgba(255, 213, 74, 0.85);
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.85),
      1px 0 0 rgba(0, 0, 0, 0.85);
  }
  .dsm-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 213, 74, 0.55);
    border-radius: 3px;
    padding: 2px 5px;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    color: #fff;
    pointer-events: none;
  }
  .dsm-tag strong {
    font-size: 0.68rem;
  }
  .dsm-kind {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
  }
  .dsm-mag {
    color: #ffd54a;
  }
  .dsm-controls {
    max-width: 420px;
    margin: 0.75rem auto 0;
    text-align: center;
  }
  .dsm-input {
    width: 100%;
  }
  .dsm-readout {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-style: italic;
  }
  .dsm-readout-count {
    opacity: 0.75;
  }
  .dsm-readout-count:not(:empty)::before {
    content: ' \2014 ';
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.deep-sky-marker-slider').forEach((widget) => {
    const input = widget.querySelector<HTMLInputElement>('.dsm-input')!;
    const markers = Array.from(widget.querySelectorAll<HTMLElement>('.dsm-marker'));
    const valueEl = widget.querySelector('.dsm-readout-value')!;
    const countEl = widget.querySelector('.dsm-readout-count')!;
    const restValue = Number(input.min);

    function apply() {
      const value = Number(input.value);
      if (value <= restValue) {
        markers.forEach((m) => m.removeAttribute('data-visible'));
        valueEl.textContent = 'Normal image';
        countEl.textContent = '';
        return;
      }
      let shown = 0;
      markers.forEach((m) => {
        const bucket = Number(m.dataset.bucket);
        if (bucket <= value) {
          m.setAttribute('data-visible', 'true');
          shown++;
        } else {
          m.removeAttribute('data-visible');
        }
      });
      valueEl.textContent = `Down to magnitude ${value}`;
      countEl.textContent = `${shown} labeled`;
    }

    input.addEventListener('input', apply);
    apply();
  });
</script>
