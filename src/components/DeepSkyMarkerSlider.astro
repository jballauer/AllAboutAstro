---
import { Image } from 'astro:assets';

interface DeepSkyMarker {
  catalogName: string;
  // Real apparent magnitude, when one exists. null for genuinely
  // diffuse/extended objects with no citable point magnitude (e.g. a star
  // cloud) -- pair with an explicit `bucket` in that case so it still has
  // a defined reveal position, just not one implying real photometry.
  mag: number | null;
  // Explicit reveal bucket, same units as `step`. Required when mag is
  // null; optional otherwise (defaults to the mag rounded up to the next
  // `step`) -- use it to force an object to appear alongside another
  // (e.g. co-locating a magnitude-less object with a real one).
  bucket?: number;
  // Short human-readable kind shown under the name (e.g. "Galaxy",
  // "Globular Cluster", "Star Cloud") -- optional, omit for a plain
  // single-line tag.
  kind?: string;
  x: number;
  y: number;
  // Tag placement is fully automatic by default (see the client-side
  // layout engine below) -- omit these for a normal marker. Set either
  // one to PIN the tag at an exact offset (px, at the frame's actual
  // rendered width) instead of letting the algorithm choose, e.g. to
  // co-locate a magnitude-less marker's label with a real one it should
  // visually accompany. A pinned tag still counts as an obstacle for
  // every other (auto-placed) marker's search. The ring itself always
  // stays exactly on the marker's real pixel position regardless.
  tagDx?: number;
  tagDy?: number;
}

interface Props {
  image: ImageMetadata;
  alt: string;
  imageWidth: number;
  imageHeight: number;
  markers: DeepSkyMarker[];
  // Bucket granularity -- 1 for a whole-magnitude spread (e.g. mag 2-10),
  // 0.1 for a tightly-clustered set (e.g. several objects all within one
  // whole magnitude of each other, where integer buckets would collapse
  // them into a single reveal step instead of staggering by real
  // brightness). Default 1.
  step?: number;
  // Slider floor/ceiling, in `step` units. Default: computed from the
  // markers' own buckets so the resting value shows nothing and the max
  // value shows everything.
  minMag?: number;
  maxMag?: number;
  // Path to a genuine higher-resolution file. When set, the frame becomes
  // click-to-zoom (site's default fullscreen lightbox) same as any other
  // article image -- the lightbox is a full-page overlay, not an in-place
  // transform, so it doesn't fight the percentage-positioned markers.
  // Omit when there's no real hi-res source on file (matches the site-wide
  // convention of not promising a zoom that doesn't deliver).
  hires?: string;
}

const {
  image,
  alt,
  imageWidth,
  imageHeight,
  markers,
  step = 1,
  minMag: minMagProp,
  maxMag: maxMagProp,
  hires,
} = Astro.props;

const decimals = step < 1 ? String(step).split('.')[1]?.length ?? 1 : 0;
function roundUpToStep(value: number): number {
  // Small epsilon so a value that's already an exact multiple of `step`
  // (e.g. mag exactly 14.0 with step 1) rounds to itself, not the next
  // step up -- Math.ceil alone would push 14.0 to 15 due to how floating
  // point division can land a hair above the exact multiple.
  const raw = Math.ceil(value / step - 1e-9) * step;
  return Number(raw.toFixed(decimals));
}
function bucketOf(m: DeepSkyMarker): number {
  return m.bucket ?? roundUpToStep(m.mag!);
}

const buckets = markers.map(bucketOf);
// The resting value must be strictly below every marker's own bucket, so
// "at rest" is guaranteed to show zero markers -- not an accident of the
// data, an explicit floor.
const minMag = minMagProp ?? Number((Math.min(...buckets) - step).toFixed(decimals));
const maxMag = maxMagProp ?? Math.max(...buckets);
// Datalist tick marks are a visual aid only (the slider itself still
// moves in `step` increments) -- one per whole number in range keeps the
// control legible even when `step` is fractional and would otherwise
// imply dozens of ticks.
const tickStart = Math.floor(minMag);
const tickEnd = Math.ceil(maxMag);
const ticks = Array.from({ length: tickEnd - tickStart + 1 }, (_, i) => tickStart + i);

const RING_RADIUS = 5; // px, half of .dsm-dot's 10px diameter
const BASE_GAP = 7; // px, the ring-bottom-to-tag-top gap with no offset
const TAG_DEFAULT_Y = RING_RADIUS + BASE_GAP; // tag's default top-center y, from ring center
function leaderGeometry(m: DeepSkyMarker) {
  const dx = m.tagDx ?? 0;
  const targetX = dx;
  const targetY = TAG_DEFAULT_Y + (m.tagDy ?? 0);
  const anchorX = dx !== 0 ? Math.sign(dx) * RING_RADIUS : 0;
  const anchorY = dx !== 0 ? 0 : RING_RADIUS;
  const vx = targetX - anchorX;
  const vy = targetY - anchorY;
  const length = Math.sqrt(vx * vx + vy * vy);
  const angleDeg = (Math.atan2(-vx, vy) * 180) / Math.PI;
  return { length, angleDeg, anchorX, anchorY };
}
---

<div class="deep-sky-marker-slider">
  <div class={hires ? 'dsm-frame' : 'dsm-frame no-lightbox'} data-hires={hires || undefined}>
    <Image src={image} alt={alt} width={imageWidth} height={imageHeight} />
    {markers.map((m) => {
      const { length, angleDeg, anchorX, anchorY } = leaderGeometry(m);
      return (
        <span
          class="dsm-marker"
          data-bucket={bucketOf(m)}
          data-pin-dx={m.tagDx ?? undefined}
          data-pin-dy={m.tagDy ?? undefined}
          style={`left:${((m.x / imageWidth) * 100).toFixed(2)}%; top:${((m.y / imageHeight) * 100).toFixed(2)}%`}
        >
          <span class="dsm-dot"></span>
          <span
            class="dsm-leader"
            style={`left:calc(50% + ${anchorX}px); top:${anchorY}px; height:${length.toFixed(2)}px; transform: translate(-50%, 0) rotate(${angleDeg.toFixed(2)}deg);`}
          ></span>
          <span
            class="dsm-tag"
            style={(m.tagDx || m.tagDy) ? `transform: translate(${m.tagDx ?? 0}px, ${m.tagDy ?? 0}px)` : undefined}
          >
            <strong>{m.catalogName}</strong>
            {m.kind && <span class="dsm-kind">{m.kind}</span>}
            {m.mag != null && <span class="dsm-mag">mag {m.mag.toFixed(1)}</span>}
          </span>
        </span>
      );
    })}
  </div>
  {hires && <p class="ke-zoom-hint">Click to Zoom</p>}
  <div class="dsm-controls">
    <input
      type="range"
      class="dsm-input"
      min={minMag}
      max={maxMag}
      step={step}
      value={minMag}
      list="dsm-ticks"
      aria-label="Reveal deep-sky objects down to this apparent magnitude"
    />
    <datalist id="dsm-ticks">
      {ticks.map((t) => <option value={t}></option>)}
    </datalist>
    <div class="dsm-readout">
      <span class="dsm-readout-value">Normal image</span>
      <span class="dsm-readout-count"></span>
    </div>
  </div>
</div>

<style>
  .deep-sky-marker-slider {
    margin: 0.3rem 0 1.5rem;
  }
  .dsm-frame {
    position: relative;
    cursor: default;
  }
  .dsm-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    cursor: default;
  }
  /* The marker's own left/top is the object's exact pixel (as a
     percentage) -- do NOT transform/center the whole dot+tag block on
     that point, or the tag ends up covering the object itself. Only
     horizontal centering is applied to the block; the ring's negative
     margin (below) pulls just the ring itself up so its center -- not
     the block's top edge -- lands exactly on the marked point. */
  .dsm-marker {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  .dsm-marker[data-visible='true'] {
    display: block;
  }
  /* Forces a measurable (but invisible) box during the client-side
     auto-layout pass, regardless of the marker's current data-visible
     state -- the layout accounts for every marker, not just the ones
     the slider currently reveals. */
  .dsm-marker.dsm-measuring {
    display: block !important;
    visibility: hidden;
  }
  /* Hollow ring, not a filled dot -- the underlying feature (galaxy core,
     nebulosity, faint point source) must stay visible through the middle
     even while marked/labeled. Same black-outline treatment as the star
     slider's ring, so it stays legible against a saturated core. */
  .dsm-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px auto 0;
    border-radius: 50%;
    border: 1.5px solid #ffd54a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.9);
  }
  .dsm-leader {
    position: absolute;
    width: 1px;
    transform-origin: top center;
    background: rgba(255, 213, 74, 0.85);
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.85),
      1px 0 0 rgba(0, 0, 0, 0.85);
  }
  .dsm-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 213, 74, 0.55);
    border-radius: 3px;
    padding: 2px 5px;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    color: #fff;
    pointer-events: none;
  }
  .dsm-tag strong {
    font-size: 0.68rem;
  }
  .dsm-kind {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
  }
  .dsm-mag {
    color: #ffd54a;
  }
  .dsm-controls {
    max-width: 420px;
    margin: 0.75rem auto 0;
    text-align: center;
  }
  .dsm-input {
    width: 100%;
  }
  .dsm-readout {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-style: italic;
  }
  .dsm-readout-count {
    opacity: 0.75;
  }
  .dsm-readout-count:not(:empty)::before {
    content: ' \2014 ';
  }
</style>

<script>
  // Automatic label placement. Runs once per widget (plus on resize/font-
  // load) and lays out EVERY marker's tag as if the slider were all the
  // way up -- not just the currently-revealed subset. A non-overlapping
  // layout for the full set is automatically non-overlapping for any
  // subset of it too, so this one computation covers every slider
  // position without needing to re-run on each `input` event. This is
  // what makes the component usable on a dense field (many markers close
  // together) without hand-tuning a tagDx/tagDy offset per marker --
  // those props still exist as an optional pin/override, but are not
  // required.
  const RING_RADIUS = 5; // px, half of .dsm-dot's 10px diameter
  const BASE_GAP = 7; // px, ring-bottom-to-tag-top gap with no offset
  const TAG_DEFAULT_Y = RING_RADIUS + BASE_GAP;
  const RING_EXCLUDE = 13; // px kept clear around every ring, labeled or not
  const EDGE_MARGIN = 4; // px kept clear at the frame's own edges
  const SEARCH_ANGLES = 16;
  const SEARCH_RADII = [26, 40, 58, 80, 105, 135, 170, 210, 250];

  function rectCircleOverlap(left: number, top: number, w: number, h: number, cx: number, cy: number, r: number) {
    const closestX = Math.max(left, Math.min(cx, left + w));
    const closestY = Math.max(top, Math.min(cy, top + h));
    const dx = cx - closestX;
    const dy = cy - closestY;
    return dx * dx + dy * dy < r * r;
  }
  function rectsOverlap(a: { left: number; top: number; w: number; h: number }, b: { left: number; top: number; w: number; h: number }) {
    return !(a.left + a.w < b.left || b.left + b.w < a.left || a.top + a.h < b.top || b.top + b.h < a.top);
  }
  function overlapArea(a: { left: number; top: number; w: number; h: number }, b: { left: number; top: number; w: number; h: number }) {
    const ox = Math.max(0, Math.min(a.left + a.w, b.left + b.w) - Math.max(a.left, b.left));
    const oy = Math.max(0, Math.min(a.top + a.h, b.top + b.h) - Math.max(a.top, b.top));
    return ox * oy;
  }
  // Shortest distance from a ring center to the ring-to-candidate line
  // segment, used to penalize a leader line that would thread through an
  // unrelated marker's ring on its way to the label.
  function segPointDist(x1: number, y1: number, x2: number, y2: number, px: number, py: number) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const lenSq = dx * dx + dy * dy;
    let t = lenSq === 0 ? 0 : ((px - x1) * dx + (py - y1) * dy) / lenSq;
    t = Math.max(0, Math.min(1, t));
    const cx = x1 + t * dx;
    const cy = y1 + t * dy;
    return Math.hypot(px - cx, py - cy);
  }

  interface LayoutItem {
    tag: HTMLElement;
    leader: HTMLElement;
    ringX: number;
    ringY: number;
    natLeft: number;
    natTop: number;
    w: number;
    h: number;
    pinDx?: number;
    pinDy?: number;
  }

  function layoutLabels(widget: HTMLElement) {
    const frame = widget.querySelector<HTMLElement>('.dsm-frame');
    const markerEls = Array.from(widget.querySelectorAll<HTMLElement>('.dsm-marker'));
    if (!frame || !markerEls.length) return;

    // Force every marker to a measurable box (display:block) without a
    // visible flash, regardless of its current slider-driven data-visible
    // state -- the layout must account for every marker, not just the
    // ones currently revealed.
    markerEls.forEach((m) => m.classList.add('dsm-measuring'));
    void frame.offsetWidth; // force reflow before measuring

    const frameRect = frame.getBoundingClientRect();
    const items: LayoutItem[] = markerEls.map((m) => {
      const dot = m.querySelector('.dsm-dot')!;
      const tag = m.querySelector<HTMLElement>('.dsm-tag')!;
      const leader = m.querySelector<HTMLElement>('.dsm-leader')!;
      tag.style.transform = ''; // reset to natural (untransformed) box before measuring
      const dr = dot.getBoundingClientRect();
      const tr = tag.getBoundingClientRect();
      const pinDx = m.dataset.pinDx ? Number(m.dataset.pinDx) : undefined;
      const pinDy = m.dataset.pinDy ? Number(m.dataset.pinDy) : undefined;
      return {
        tag,
        leader,
        ringX: dr.x + dr.width / 2 - frameRect.x,
        ringY: dr.y + dr.height / 2 - frameRect.y,
        natLeft: tr.x - frameRect.x,
        natTop: tr.y - frameRect.y,
        w: tr.width,
        h: tr.height,
        pinDx,
        pinDy,
      };
    });

    const placed: { left: number; top: number; w: number; h: number }[] = [];

    function ringClear(left: number, top: number, w: number, h: number, selfIndex: number) {
      for (let j = 0; j < items.length; j++) {
        if (j === selfIndex) continue;
        if (rectCircleOverlap(left, top, w, h, items[j].ringX, items[j].ringY, RING_EXCLUDE)) return false;
      }
      return true;
    }
    function inBounds(left: number, top: number, w: number, h: number) {
      return left >= EDGE_MARGIN && top >= EDGE_MARGIN && left + w <= frameRect.width - EDGE_MARGIN && top + h <= frameRect.height - EDGE_MARGIN;
    }
    function crossingPenalty(ringX: number, ringY: number, cx: number, cy: number, selfIndex: number) {
      let crossings = 0;
      for (let j = 0; j < items.length; j++) {
        if (j === selfIndex) continue;
        if (segPointDist(ringX, ringY, cx, cy, items[j].ringX, items[j].ringY) < RING_EXCLUDE) crossings++;
      }
      return crossings;
    }

    items.forEach((item, i) => {
      let best: { cx: number; cy: number; left: number; top: number } | null = null;

      if (item.pinDx !== undefined || item.pinDy !== undefined) {
        const dx = item.pinDx ?? 0;
        const dy = item.pinDy ?? 0;
        const cx = item.natLeft + item.w / 2 + dx;
        const cy = item.natTop + item.h / 2 + dy;
        best = { cx, cy, left: cx - item.w / 2, top: cy - item.h / 2 };
      }

      // Pass 1: fully clear of every ring and every already-placed tag.
      if (!best) {
        let bestScore = Infinity;
        for (const radius of SEARCH_RADII) {
          let foundAtRadius: typeof best = null;
          let foundScore = Infinity;
          for (let a = 0; a < SEARCH_ANGLES; a++) {
            const angle = (a / SEARCH_ANGLES) * Math.PI * 2;
            const cx = item.ringX + radius * Math.cos(angle);
            const cy = item.ringY + radius * Math.sin(angle);
            const left = cx - item.w / 2;
            const top = cy - item.h / 2;
            if (!inBounds(left, top, item.w, item.h)) continue;
            if (!ringClear(left, top, item.w, item.h, i)) continue;
            const box = { left, top, w: item.w, h: item.h };
            if (placed.some((p) => rectsOverlap(box, p))) continue;
            const score = crossingPenalty(item.ringX, item.ringY, cx, cy, i) * 40;
            if (score < foundScore) {
              foundScore = score;
              foundAtRadius = { cx, cy, left, top };
            }
          }
          if (foundAtRadius) {
            best = foundAtRadius;
            bestScore = foundScore;
            break; // closest usable radius wins
          }
        }
        void bestScore;
      }

      // Pass 2 (dense-field fallback): ring-clear is still required (never
      // cover an unlabeled object), but allow the *least-bad* tag overlap
      // rather than leaving the label unplaced.
      if (!best) {
        let bestScore = Infinity;
        for (const radius of SEARCH_RADII) {
          for (let a = 0; a < SEARCH_ANGLES; a++) {
            const angle = (a / SEARCH_ANGLES) * Math.PI * 2;
            const cx = item.ringX + radius * Math.cos(angle);
            const cy = item.ringY + radius * Math.sin(angle);
            const left = cx - item.w / 2;
            const top = cy - item.h / 2;
            if (!inBounds(left, top, item.w, item.h)) continue;
            if (!ringClear(left, top, item.w, item.h, i)) continue;
            const box = { left, top, w: item.w, h: item.h };
            const overlap = placed.reduce((sum, p) => sum + overlapArea(box, p), 0);
            const score = radius + overlap * 3;
            if (score < bestScore) {
              bestScore = score;
              best = { cx, cy, left, top };
            }
          }
        }
      }

      // Last resort: the pre-existing default (directly below the ring),
      // if literally nothing else satisfied even ring-clearance.
      if (!best) {
        const cx = item.ringX;
        const cy = item.ringY + TAG_DEFAULT_Y + item.h / 2;
        best = { cx, cy, left: cx - item.w / 2, top: item.ringY + TAG_DEFAULT_Y };
      }

      placed.push({ left: best.left, top: best.top, w: item.w, h: item.h });

      const dx = best.cx - (item.natLeft + item.w / 2);
      const dy = best.cy - (item.natTop + item.h / 2);
      item.tag.style.transform = `translate(${dx}px, ${dy}px)`;

      const targetX = dx;
      const targetY = TAG_DEFAULT_Y + dy;
      const anchorX = dx !== 0 ? Math.sign(dx) * RING_RADIUS : 0;
      const anchorY = dx !== 0 ? 0 : RING_RADIUS;
      const vx = targetX - anchorX;
      const vy = targetY - anchorY;
      const length = Math.sqrt(vx * vx + vy * vy);
      const angleDeg = (Math.atan2(-vx, vy) * 180) / Math.PI;
      item.leader.style.left = `calc(50% + ${anchorX}px)`;
      item.leader.style.top = `${anchorY}px`;
      item.leader.style.height = `${length.toFixed(2)}px`;
      item.leader.style.transform = `translate(-50%, 0) rotate(${angleDeg.toFixed(2)}deg)`;
    });

    markerEls.forEach((m) => m.classList.remove('dsm-measuring'));
  }

  document.querySelectorAll<HTMLElement>('.deep-sky-marker-slider').forEach((widget) => {
    const input = widget.querySelector<HTMLInputElement>('.dsm-input')!;
    const markers = Array.from(widget.querySelectorAll<HTMLElement>('.dsm-marker'));
    const valueEl = widget.querySelector('.dsm-readout-value')!;
    const countEl = widget.querySelector('.dsm-readout-count')!;
    const restValue = Number(input.min);

    function apply() {
      const value = Number(input.value);
      if (value <= restValue) {
        markers.forEach((m) => m.removeAttribute('data-visible'));
        valueEl.textContent = 'Normal image';
        countEl.textContent = '';
        return;
      }
      let shown = 0;
      markers.forEach((m) => {
        const bucket = Number(m.dataset.bucket);
        if (bucket <= value) {
          m.setAttribute('data-visible', 'true');
          shown++;
        } else {
          m.removeAttribute('data-visible');
        }
      });
      valueEl.textContent = `Down to magnitude ${value}`;
      countEl.textContent = `${shown} labeled`;
    }

    input.addEventListener('input', apply);
    apply();

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => layoutLabels(widget), 200);
    });

    layoutLabels(widget);
    if ('fonts' in document) {
      (document as Document).fonts.ready.then(() => layoutLabels(widget));
    }
  });
</script>
