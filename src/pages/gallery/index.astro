---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import GalleryTile from '../../components/GalleryTile.astro';
import toolExampleImage from '../../content/gallery/_images/m45-pleiades-mosaic.jpg';

const allImages = await getCollection('gallery', ({ data }) => !data.draft && data.showInGallery);

// Pages still carrying the "*Information about this image and its
// acquisition is forthcoming.*" placeholder never had a real capture date
// recorded -- their pubDate is just the date the AI-stub page was created
// during migration, not when the photo was taken. Chronological order only
// makes sense for entries with a real, known date, so those go first
// (newest first); undated stubs are appended after, alphabetically.
const hasKnownDate = (entry: (typeof allImages)[number]) => !entry.body?.includes('is forthcoming');

const known = allImages
  .filter(hasKnownDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const undated = allImages
  .filter((entry) => !hasKnownDate(entry))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const images = [...known, ...undated];

// Square thumbnail crops center by default, which works fine for the
// site's typically near-square astrophotos. A non-square source (e.g. a
// 16:9 video-frame thumbnail) needs an explicit crop position so the
// subject doesn't get cut off -- see the comet-neowise-timelapse entry.
const thumbPosition: Record<string, string> = {
  'comet-neowise-timelapse': 'left',
};
---

<BaseLayout title="Astro Gallery">
  <article>
  <h1>Astrophotography by Jay Ballauer</h1>
  <p>Here is a selection of just some of the images I have taken over the many years of pointing a telescope at the night sky. For the most part, they are taken with a wide variety of apochromatic refractors, ranging from 3" to 6", with narrow-field images taken with a 12.5" RCOS RC. A variety of cameras are used and you can assume that the images are from a cooled astro CCD unless otherwise indicated in the title. Clicking on any of the images will bring up a separate page with more information about it. My goal is to add more images over time, as well as provide more of the individual pages full of details about them.</p>
  <aside class="ke-sidebar" data-side="right">
    <h2>Sidebar: AllAboutAstro Labeling Tool</h2>
    <span class="at-example-frame" data-hires={toolExampleImage.src}>
      <Image src={toolExampleImage} alt="Pleiades (M45) mosaic, labeled with the tool" width={900} />
    </span>
    <p class="at-example-caption"><a href="/gallery/m45-pleiades-mosaic/">See it live on the Pleiades mosaic &rarr;</a></p>
    <p>I built this myself, and it's dead simple to use: upload a photo, click one button, and it figures out exactly where in the sky it's pointed &mdash; no typing in coordinates, no account, no special knowledge needed.</p>
    <p>Once it knows what it's looking at, you can add sliders that reveal the stars, galaxies, and nebulae hiding in your shot, dragging deeper to bring in fainter ones, each one labeled with its real name straight from professional catalogs. It's a great way to finally find out what's actually in a photo you took &mdash; then download the labeled version to keep.</p>
    <p><a href="/astrometric-tool/">Open the tool &rarr;</a></p>
  </aside>
  <p>Some images also include an interactive slider below them &mdash; drag it to reveal the stars in that photo, labeled with their name and magnitude, straight from real astronomical catalogs. I created the tool and I thought you'd appreciate trying it with your own images! (see Sidebar: AllAboutAstro Labeling Tool).</p>
  <p>Still sorting through older images from past cameras and setups? Take a look at the <a href="/gallery/legacy/">legacy gallery</a> &mdash; a working area of earlier and lesser attempts that haven't yet made the cut for the main collection above.</p>
  <div class="grid">
    {images.map((entry) => (
      <GalleryTile
        id={entry.id}
        title={entry.data.title}
        image={entry.data.image}
        thumbnailImage={entry.data.thumbnailImage}
        position={thumbPosition[entry.id]}
      />
    ))}
  </div>
  </article>
</BaseLayout>

<style>
  /* One grid, one tile size, throughout -- the sidebar is a plain float,
     and the tiles are inline-block (not floats, not a grid/flex container)
     so they wrap around it exactly the way body text does: 2 fit per line
     while the sidebar is active, 4 once it's cleared, all at the same
     fixed size. (Two earlier attempts got this wrong: floated tiles can
     strand a gap when a much taller opposing float is involved, since the
     float-placement algorithm searches for "highest available" slots
     rather than laying out strictly line-by-line; a CSS grid/flexbox
     container avoids a float using its width *at the point it starts*,
     then keeps that width for its whole height even after the float ends,
     wasting the freed-up space below. Plain inline-block content re-lays
     out fresh on every line, so it can't develop either problem.)

     Getting even gutters without an nth-child(4n)-style "is this the last
     one in its row" check (which breaks the moment a row doesn't have
     exactly 4 items, i.e. every row beside the sidebar) needs the classic
     negative-margin trick instead: every tile gets a left gutter,
     including the first one in each row, and the container's matching
     negative left margin swallows that leading gutter back to zero -- so
     each row starts flush regardless of how many tiles are in it. */
  .grid {
    margin-top: 1.5rem;
    margin-left: -1.5rem;
    font-size: 0;
  }
  /* Tile width as a fraction of .grid's own content box (its containing
     block for the percentage below) -- NOT of the article. Because
     .grid's negative margin-left makes its content box exactly one
     gutter wider than the article (auto-width absorbs the negative
     margin), "1/4 of container, minus one gutter" is the formula that
     makes a full row of 4 actually span the article's real width: with
     G = article-width + gutter, solving 4t + 3*gutter = article-width for
     t and rewriting in terms of G gives t = G/4 - gutter, i.e. `25% -
     gutter` below (not the more obvious-looking `(100% - 3*gutter)/4`,
     which is 100% of the *wrong* (wider) base and overshoots). */
  .grid :global(.tile) {
    width: calc(25% - 1.5rem);
    margin: 0 0 1.5rem 1.5rem;
    font-size: var(--font-body-size);
  }
  @media (max-width: 900px) {
    .grid :global(.tile) {
      width: calc(33.3333% - 1.5rem);
    }
  }
  @media (max-width: 600px) {
    .grid :global(.tile) {
      width: calc(50% - 1.5rem);
    }
  }
  @media (max-width: 420px) {
    .grid {
      margin-left: 0;
    }
    .grid :global(.tile) {
      width: 100%;
      margin-left: 0;
    }
  }
  /* The sidebar's width is picked so exactly 2 (fixed-size, 4-column-wide)
     tiles fit on the line beside it: available-width-beside-sidebar must
     equal 2 tile-widths + 1 gutter between them. Solving that against the
     tile-width formula above (and the sidebar's own 1.75rem left gutter)
     gives 50% - 16px -- not a round number, but it's what makes the two
     column counts line up instead of just approximately fitting. */
  @media (min-width: 701px) {
    .ke-sidebar[data-side='right'] {
      width: calc(50% - 16px);
    }
  }
  .at-example-frame {
    display: block;
  }
  .at-example-frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    cursor: zoom-in;
  }
  .at-example-caption {
    margin: 0.5rem 0 1rem;
    font-size: 0.85rem;
  }
</style>
