export async function getStaticPaths() {
  const images = await getCollection('gallery');
  return images.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hires = hiresMap[entry.id];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    {entry.id === 'm45-pleiades-mosaic' ? (
      <StarMagnitudeSlider
        image={entry.data.image}
        alt={entry.data.title}
        imageWidth={1030}
        imageHeight={800}
        stars={m45HeroStars}
      />
    ) : entry.id === 'm20-trifid-nebula' ? (
      <StarMagnitudeSlider
        image={entry.data.image}
        alt={entry.data.title}
        imageWidth={1082}
        imageHeight={800}
        stars={m20HeroStars}
        maxMag={12}
      />
    ) : (
      entry.id !== 'comet-neowise-timelapse' && entry.data.image && (
        <>
          {hires ? (
            <span data-hires={hires}>
              <Image
                src={entry.data.image}
                alt={entry.data.title}
                width={1000}
                height={Math.round((1000 * entry.data.image.height) / entry.data.image.width)}
                class={entry.id === 'm31-mosaic' ? 'ke-zoom-inframe' : undefined}
              />
            </span>
          ) : (
            // No genuine higher-resolution source on file for this image --
            // it's already displayed at (or near) its native resolution, so
            // a "zoom" would just reopen the same-size image. Suppress the
            // hint and skip the lightbox rather than promise a zoom that
            // doesn't deliver.
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              width={1000}
              height={Math.round((1000 * entry.data.image.height) / entry.data.image.width)}
              class="no-lightbox"
            />
          )}
          {hires && <p class="ke-zoom-hint">Click to Zoom</p>}
        </>
      )
    )}
    {entry.data.equipment && <p><strong>Equipment:</strong> {entry.data.equipment}</p>}
    {entry.data.exposure && <p><strong>Exposure:</strong> {entry.data.exposure}</p>}
    <Content />
    {entry.id === 'great-american-solar-eclipse-2017' && (
      <>
        <div class="ke-clear"></div>
        <h3>Slide Show of Event Photos</h3>
        <PhotoCarousel photos={eclipse2017EventPhotos} />
      </>
    )}
  </article>
</BaseLayout>
