---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fill in after deploying the Cloudflare Worker (see
// workers/astrometric-tool/README.md) -- `npx wrangler deploy` prints the
// URL, something like https://astrometric-tool.<subdomain>.workers.dev
const WORKER_URL = 'https://astrometric-tool.jballauer.workers.dev';

// Reference blurbs for every catalog/list slider -- static content, shown
// regardless of tool state, so it's not tied to the client-side script.
const CATALOG_GUIDE = [
  { name: 'Messier', body: 'Charles Messier’s 1771–1781 list of 110 bright, fixed deep-sky objects -- compiled not to celebrate them, but to help comet hunters avoid mistaking them for new comets. Nearly all of the sky’s showpiece galaxies, clusters, and nebulae are on it.' },
  { name: 'NGC', body: 'The New General Catalogue (J.L.E. Dreyer, 1888), 7,840 deep-sky objects compiled from the Herschels’ visual survey work and other 19th-century observers. Still the primary reference designation for most galaxies, clusters, and nebulae.' },
  { name: 'IC', body: 'The Index Catalogue (Dreyer, 1895 and 1908), two supplements to the NGC adding 5,386 more objects found after 1888, many via early astrophotography rather than visual observation.' },
  { name: 'Barnard', body: 'E.E. Barnard’s 1919 catalogue of 349 dark nebulae -- obscuring dust clouds silhouetted against the Milky Way’s star fields, identified from his own wide-field photographic plates.' },
  { name: 'Sharpless', body: 'Stewart Sharpless’s 1959 catalogue (Sh2) of 313 HII emission regions -- glowing hydrogen gas clouds, mostly star-forming nebulae, mapped from the National Geographic-Palomar Sky Survey.' },
  { name: 'LBN', body: 'Beverly Lynds’s 1965 Catalogue of Bright Nebulae, ~1,100 emission and reflection nebulae identified visually from photographic plates and rated by surface brightness and form.' },
  { name: 'LDN', body: 'Beverly Lynds’s 1962 Catalogue of Dark Nebulae -- ~1,800 obscuring dust clouds cataloged from the same photographic survey work as LBN, rated by opacity rather than brightness.' },
  { name: 'Arp', body: 'Halton Arp’s 1966 "Atlas of Peculiar Galaxies," 338 galaxies chosen specifically for unusual/disturbed morphology -- interacting pairs, tidal tails, ring galaxies -- rather than brightness or size.' },
  { name: 'Herschel 400', body: 'A 400-object observing list curated by the Astronomical League from William Herschel’s much larger 18th-century discovery catalogue (2,500+ objects) -- selected as a challenging but achievable "next step" past the Messier list for visual observers.' },
  { name: 'Herschel II', body: 'A second, complementary 400-object Herschel list, originally selected by the Rose City Astronomers (Portland, OR) in 1997 and adopted by the Astronomical League as a follow-on observing program to Herschel 400.' },
  { name: 'Caldwell', body: 'Patrick Moore’s 1995 list of 109 bright deep-sky objects, deliberately built to complement Messier’s list by including showpiece objects Messier missed -- mostly ones too far south for his Paris latitude, or just outside his comet-hunting focus.' },
  { name: 'Bayer', body: 'Johann Bayer’s 1603 system of naming naked-eye stars within a constellation by Greek letter, roughly in order of brightness (e.g. Alpha Canis Majoris = Sirius). The most recognized designation for bright stars, and the one usually paired with a common name.' },
  { name: 'Flamsteed', body: 'John Flamsteed’s early-18th-century numbering of naked-eye stars within each constellation (e.g. "51 Peg"), ordered roughly by right ascension. Still the standard designation for many bright stars without a proper name.' },
  { name: 'WDS', body: 'The Washington Double Star Catalog (US Naval Observatory), the world’s principal database of double and multiple star systems -- over 150,000 pairs, identified by coordinate-based designation and component letter (A, B, Aa/Ab, ...).' },
  { name: 'HIP', body: 'The Hipparcos catalogue, ~118,000 stars with precision positions/parallaxes/proper motions measured by ESA’s Hipparcos satellite (1989–1993) -- the standard reference for stellar astrometry before Gaia.' },
  { name: 'SAO', body: 'The Smithsonian Astrophysical Observatory Star Catalog (1966), ~258,000 stars to about 9th magnitude with positions, proper motions, and photometry -- a workhorse all-sky catalog predating Hipparcos.' },
  { name: 'WD', body: 'White dwarf catalogues (McCook & Sion and successors) listing confirmed white dwarf stars -- the dense, faint stellar remnants left behind after a Sun-like star exhausts its fuel.' },
  { name: 'BD', body: 'The Bonner Durchmusterung (1859–1903), a massive 19th-century positional survey of the Northern and equatorial sky (~325,000 stars to about 9th–10th magnitude) -- one of the foundational all-sky star catalogues.' },
];
---

<BaseLayout
  title="AllAboutAstro Labeling Tool"
  description="Upload an astrophoto, plate-solve it, and add sliders that label the stars and deep-sky objects in the field."
>
  <article class="at-tool">
    <h1>AllAboutAstro Labeling Tool</h1>
    <p>
      Upload your own astrophoto. It gets plate-solved against the real sky, then you can add
      sliders that reveal labels for stars, galaxies, and clusters in the field -- each one down
      to whatever brightness you drag it to. When you're happy with it, download the labeled
      image.
    </p>

    <section class="at-upload">
      <input type="file" id="at-file-input" accept="image/*" hidden />
      <button type="button" id="at-upload-btn">Upload Image</button>
      <p class="at-hint">JPEG or PNG, up to 10MB.</p>
    </section>

    <div class="at-workspace">
      <div class="at-image-col">
        <div class="at-frame-wrap" id="at-frame-wrap" hidden>
          <div class="at-frame" id="at-frame">
            <img id="at-preview-img" alt="Uploaded astrophoto preview" />
          </div>
        </div>

        <div class="at-info-bar" id="at-info-bar" hidden>
          <dl class="at-image-specs">
            <div><dt>Resolution</dt><dd id="at-spec-resolution">&mdash;</dd></div>
            <div><dt>Image scale</dt><dd id="at-spec-scale">&mdash;</dd></div>
            <div><dt>Field of view</dt><dd id="at-spec-fov">&mdash;</dd></div>
            <div><dt>Center (RA, Dec)</dt><dd id="at-spec-center">&mdash;</dd></div>
          </dl>
          <button type="button" id="at-download-btn">Download labeled image</button>
        </div>
      </div>

      <aside class="at-sidebar">
        <div class="at-solve-panel" id="at-solve-panel" hidden>
          <button type="button" id="at-solve-btn">Plate-solve this image</button>
          <p class="at-status" id="at-solve-status" role="status"></p>
        </div>

        <div class="at-categories" id="at-categories" hidden>
          <p>Add a slider, by object type:</p>
          <div class="at-category-buttons">
            <button type="button" data-category="stars">+ Stars</button>
            <button type="button" data-category="galaxies">+ Galaxies</button>
            <button type="button" data-category="globular">+ Globular Clusters</button>
            <button type="button" data-category="open">+ Open Clusters</button>
            <button type="button" data-category="hii">+ HII Regions</button>
            <button type="button" data-category="reflection">+ Reflection Nebulae</button>
          </div>
          <p>...or by catalog (any object type):</p>
          <div class="at-category-buttons">
            <button type="button" data-category="messier">+ Messier</button>
            <button type="button" data-category="ngc">+ NGC</button>
            <button type="button" data-category="ic">+ IC</button>
            <button type="button" data-category="barnard">+ Barnard</button>
            <button type="button" data-category="arp">+ Arp</button>
            <button type="button" data-category="herschel400">+ Herschel 400</button>
            <button type="button" data-category="herschel2">+ Herschel II</button>
            <button type="button" data-category="caldwell">+ Caldwell</button>
            <button type="button" data-category="sharpless">+ Sharpless</button>
            <button type="button" data-category="lbn">+ LBN</button>
            <button type="button" data-category="ldn">+ LDN</button>
          </div>
          <p>...or by star catalog:</p>
          <div class="at-category-buttons">
            <button type="button" data-category="bayer">+ Bayer</button>
            <button type="button" data-category="flamsteed">+ Flamsteed</button>
            <button type="button" data-category="wds">+ WDS</button>
            <button type="button" data-category="hip">+ HIP</button>
            <button type="button" data-category="sao">+ SAO</button>
            <button type="button" data-category="wd">+ WD</button>
            <button type="button" data-category="bd">+ BD</button>
          </div>
          <p class="at-status" id="at-category-status" role="status"></p>
        </div>

        <div class="at-sliders-panel" id="at-sliders-panel" hidden>
          <button type="button" id="at-reset-sliders-btn">Reset sliders</button>
          <div class="at-sliders" id="at-sliders"></div>
        </div>
      </aside>
    </div>

    <section class="at-catalog-guide">
      <h2>About the catalogs</h2>
      <div class="at-catalog-guide-grid">
        {CATALOG_GUIDE.map((c) => (
          <div class="at-catalog-guide-item">
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* Global, not scoped -- the marker/tag/leader elements below are created
     at runtime via document.createElement(), so they never get Astro's
     scoped data-astro-cid attribute and scoped selectors would silently
     never match them. */
  /* This is a standalone tool page, not article prose -- the sitewide
     960px reading-width container makes no sense here (the whole point
     is seeing the image and its slider controls at once), so both the
     shared `main` element and this page's own content are widened. The
     `:has()` selector scopes the `main` override to only pages
     containing `.at-tool`, leaving every other page's width untouched
     without editing BaseLayout.astro itself. */
  main:has(.at-tool) {
    max-width: min(1800px, 96vw);
  }
  .at-tool {
    max-width: 100%;
  }
  .at-workspace {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .at-image-col {
    flex: 1 1 auto;
    min-width: 0; /* allow the flex item to shrink below the image's natural width */
  }
  .at-sidebar {
    flex: 0 0 340px;
    /* Keeps the sliders in view alongside the image while scrolling a
       tall image, rather than requiring a trip back up the page to
       reach them -- the whole reason for this side-by-side layout. */
    position: sticky;
    top: 1rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }
  @media (max-width: 900px) {
    .at-workspace {
      flex-direction: column;
    }
    .at-sidebar {
      position: static;
      max-height: none;
      flex-basis: auto;
      width: 100%;
    }
  }
  .at-upload {
    margin: 1.25rem 0;
  }
  .at-hint {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0.35rem 0 0;
  }
  .at-frame-wrap {
    margin: 1rem 0;
  }
  .at-frame {
    position: relative;
  }
  .at-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .at-info-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.75rem 0 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
  .at-image-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .at-image-specs > div {
    display: flex;
    flex-direction: column;
  }
  .at-image-specs dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.65;
  }
  .at-image-specs dd {
    margin: 0;
    font-weight: bold;
  }
  .at-catalog-guide {
    margin: 2.5rem 0 1rem;
    max-width: 900px;
  }
  .at-catalog-guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .at-catalog-guide-item h3 {
    margin: 0 0 0.3rem;
    font-size: 1rem;
  }
  .at-catalog-guide-item p {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.85;
  }
  .at-solve-panel,
  .at-categories,
  .at-download {
    margin: 0 0 1.25rem;
  }
  .at-status {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-style: italic;
    opacity: 0.8;
    min-height: 1.2em;
  }
  .at-category-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  button {
    font-family: var(--font-body);
    cursor: pointer;
  }
  button:disabled {
    cursor: default;
    opacity: 0.55;
  }

  /* Marker + slider styling -- same visual language as
     DeepSkyMarkerSlider.astro's .dsm-* classes, reused here since these
     markers are created dynamically at runtime rather than at build time. */
  .at-marker {
    position: absolute;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  .at-marker[data-visible='true'] {
    display: block;
  }
  .at-marker.at-measuring {
    display: block !important;
    visibility: hidden;
  }
  .at-dot {
    display: block;
    width: 10px;
    height: 10px;
    margin: -5px auto 0;
    border-radius: 50%;
    border: 1.5px solid #ffd54a;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.9);
  }
  .at-leader {
    position: absolute;
    width: 1px;
    transform-origin: top center;
    background: rgba(255, 213, 74, 0.85);
    box-shadow:
      -1px 0 0 rgba(0, 0, 0, 0.85),
      1px 0 0 rgba(0, 0, 0, 0.85);
  }
  .at-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 213, 74, 0.55);
    border-radius: 3px;
    padding: 2px 5px;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: 0.62rem;
    color: #fff;
    pointer-events: none;
  }
  .at-tag strong {
    font-size: 0.68rem;
  }
  .at-kind {
    color: rgba(255, 255, 255, 0.65);
    font-style: italic;
  }
  .at-mag {
    color: #ffd54a;
  }

  /* Faint dashed sky-outline for large Messier/NGC objects -- like a star
     chart's footprint symbol, not meant to be a precise boundary. */
  .at-outline {
    position: absolute;
    box-sizing: border-box;
    border: 1px dashed rgba(255, 213, 74, 0.5);
    border-radius: 50%;
    pointer-events: none;
    display: none;
  }
  .at-outline[data-visible='true'] {
    display: block;
  }

  .at-sliders-panel {
    margin: 0 0 1.25rem;
  }
  #at-reset-sliders-btn {
    margin-bottom: 0.5rem;
  }
  .at-slider-block {
    max-width: 420px;
    margin: 0.9rem 0;
  }
  .at-slider-block .at-slider-title {
    font-weight: bold;
    margin: 0 0 0.25rem;
  }
  .at-slider-block input[type='range'] {
    width: 100%;
  }
  .at-readout {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-style: italic;
  }
  .at-readout-count {
    opacity: 0.75;
  }
  .at-readout-count:not(:empty)::before {
    content: ' \2014 ';
  }
</style>

<script define:vars={{ WORKER_URL }}>
  // ---------------------------------------------------------------------
  // Constants shared with the label-layout engine (ported from
  // DeepSkyMarkerSlider.astro's client-side script -- same algorithm,
  // applied here to markers created at runtime instead of at build time).
  // ---------------------------------------------------------------------
  const RING_RADIUS = 5;
  const BASE_GAP = 7;
  const TAG_DEFAULT_Y = RING_RADIUS + BASE_GAP;
  const RING_EXCLUDE = 13;
  const EDGE_MARGIN = 4;
  const SEARCH_ANGLES = 16;
  const SEARCH_RADII = [26, 40, 58, 80, 105, 135, 170, 210, 250];

  const CATEGORY_META = {
    // Reported live 2026-08-01 (Jay): a sparse field (Helix Nebula) only
    // had 6 stars down to mag 12 -- bumped to 15 so sparse fields have more
    // range to actually reveal. Dense fields are protected separately by
    // the worker's own MAX_ROWS_PER_QUERY brightness-ordered cap, so this
    // doesn't reopen the "overwhelming label count" risk.
    stars: { label: 'Stars', maglimit: 15, kind: null },
    galaxies: { label: 'Galaxies', maglimit: 15, kind: 'Galaxy' },
    globular: { label: 'Globular Clusters', maglimit: 12, kind: 'Globular Cluster' },
    open: { label: 'Open Clusters', maglimit: 12, kind: 'Open Cluster' },
    hii: { label: 'HII Regions', maglimit: 15, kind: 'HII Region' },
    reflection: { label: 'Reflection Nebulae', maglimit: 15, kind: 'Reflection Nebula' },
    // Catalog sliders span every object type on purpose -- no fixed
    // `kind` label, since a Messier/NGC/IC/Barnard result can be a
    // galaxy, cluster, or nebula. buildMarkerEl() falls back to a
    // friendly name for the object's real SIMBAD otype instead.
    messier: { label: 'Messier', maglimit: 15, kind: null },
    ngc: { label: 'NGC', maglimit: 15, kind: null },
    ic: { label: 'IC', maglimit: 15, kind: null },
    barnard: { label: 'Barnard', maglimit: 15, kind: null },
    arp: { label: 'Arp', maglimit: 15, kind: null },
    herschel400: { label: 'Herschel 400', maglimit: 15, kind: null },
    herschel2: { label: 'Herschel II', maglimit: 15, kind: null },
    caldwell: { label: 'Caldwell', maglimit: 15, kind: null },
    // Both nebula catalogs -- Sharpless is HII regions almost exclusively
    // (no citable point magnitude in SIMBAD for most, hence the deep
    // default and reliance on the sparse-retry-to-18 fallback below), LBN
    // is a mix of emission/reflection nebulae with similarly patchy
    // photometry.
    sharpless: { label: 'Sharpless', maglimit: 15, kind: null },
    lbn: { label: 'LBN', maglimit: 15, kind: null },
    ldn: { label: 'LDN', maglimit: 15, kind: null },
    // Star catalogs default shallower than the deep-sky ones -- HIP/SAO/BD
    // in particular catalog hundreds of thousands of stars each, so an
    // unbounded query on a rich field would return an unusable/slow flood
    // of results. The auto-widen-if-sparse logic below still deepens these
    // to mag 18 on a field where even this default turns up 2 or fewer.
    // Bayer designations only exist for naked-eye stars (down to ~mag 6.5
    // by convention), so a shallower default than Flamsteed is correct
    // here, not just consistent with it.
    bayer: { label: 'Bayer', maglimit: 7, kind: null },
    flamsteed: { label: 'Flamsteed', maglimit: 10, kind: null },
    wds: { label: 'WDS (double stars)', maglimit: 10, kind: null },
    hip: { label: 'HIP (Hipparcos)', maglimit: 9, kind: null },
    sao: { label: 'SAO', maglimit: 9, kind: null },
    wd: { label: 'WD (white dwarfs)', maglimit: 15, kind: null },
    bd: { label: 'BD', maglimit: 10, kind: null },
  };

  // Human-readable labels for the handful of SIMBAD otype codes this tool's
  // categories actually surface -- used as a fallback "kind" line on
  // catalog-slider markers, which span multiple object types and so can't
  // use a single fixed kind label the way the type-only sliders do.
  const OTYPE_LABELS = {
    'GlC': 'Globular Cluster',
    'OpC': 'Open Cluster',
    'HII': 'HII Region',
    'RNe': 'Reflection Nebula',
    'DNe': 'Dark Nebula',
    'G': 'Galaxy',
    'AGN': 'Galaxy (AGN)',
    'Sy1': 'Seyfert Galaxy',
    'Sy2': 'Seyfert Galaxy',
    'SyG': 'Seyfert Galaxy',
    'PN': 'Planetary Nebula',
  };

  const D2R = Math.PI / 180;
  const R2D = 180 / Math.PI;

  function formatDegArcmin(deg) {
    const d = Math.floor(deg);
    const m = (deg - d) * 60;
    return `${d}° ${m.toFixed(1)}'`;
  }
  function formatRaDec(raDeg, decDeg) {
    const raH = raDeg / 15;
    const rh = Math.floor(raH);
    const rm = Math.floor((raH - rh) * 60);
    const rs = ((raH - rh) * 60 - rm) * 60;
    const decSign = decDeg < 0 ? '−' : '+';
    const decAbs = Math.abs(decDeg);
    const dd = Math.floor(decAbs);
    const dm = Math.floor((decAbs - dd) * 60);
    const ds = ((decAbs - dd) * 60 - dm) * 60;
    const pad2 = (n) => String(n).padStart(2, '0');
    return `${pad2(rh)}h ${pad2(rm)}m ${rs.toFixed(1)}s, ${decSign}${pad2(dd)}° ${pad2(dm)}' ${ds.toFixed(0)}"`;
  }

  function radecToPixel(wcs, raDeg, decDeg) {
    const a0 = wcs.CRVAL1 * D2R;
    const d0 = wcs.CRVAL2 * D2R;
    const a = raDeg * D2R;
    const d = decDeg * D2R;
    const cosc = Math.sin(d0) * Math.sin(d) + Math.cos(d0) * Math.cos(d) * Math.cos(a - a0);
    const xi = ((Math.cos(d) * Math.sin(a - a0)) / cosc) * R2D;
    const eta = ((Math.cos(d0) * Math.sin(d) - Math.sin(d0) * Math.cos(d) * Math.cos(a - a0)) / cosc) * R2D;
    const det = wcs.CD1_1 * wcs.CD2_2 - wcs.CD1_2 * wcs.CD2_1;
    let u = (wcs.CD2_2 * xi - wcs.CD1_2 * eta) / det;
    let v = (-wcs.CD2_1 * xi + wcs.CD1_1 * eta) / det;
    // Inverse SIP distortion correction, where the solve has it -- the
    // plain linear CD-matrix math above is only exact at the tangent
    // point and drifts increasingly toward the frame's edges/corners on
    // any field with real optical distortion. Reported live 2026-08-01:
    // two objects genuinely near the edge of a real photo (M91, NGC 4571)
    // computed to just-outside-frame pixel positions without this term,
    // while every more-central object on the same solve was unaffected.
    if (wcs.apTerms && wcs.apTerms.length) {
      let du = 0;
      let dv = 0;
      for (const t of wcs.apTerms) du += t.coeff * Math.pow(u, t.p) * Math.pow(v, t.q);
      for (const t of wcs.bpTerms) dv += t.coeff * Math.pow(u, t.p) * Math.pow(v, t.q);
      u += du;
      v += dv;
    }
    return { x: wcs.CRPIX1 + u, y: wcs.CRPIX2 + v };
  }

  // SIMBAD's galdim_angle is a position angle measured East of North on the
  // sky, not a screen-space rotation -- rather than assume the photo is
  // plain North-up/East-left (real uploads can be rotated or mirrored),
  // project the major/minor axis endpoints through the same radecToPixel()
  // math used for every marker and measure the resulting angle in actual
  // image-pixel space, so the ellipse's orientation matches this photo's
  // real WCS solution regardless of its rotation/parity.
  function outlineEllipsePixels(wcs, raDeg, decDeg, majArcmin, minArcmin, angleDeg) {
    const cosDecFactor = Math.cos(decDeg * D2R);
    const paRad = angleDeg * D2R;
    function endpoint(semiAxisArcmin, angleRad) {
      const distDeg = semiAxisArcmin / 60;
      const dNorth = distDeg * Math.cos(angleRad);
      const dEast = distDeg * Math.sin(angleRad);
      return radecToPixel(wcs, raDeg + dEast / cosDecFactor, decDeg + dNorth);
    }
    const center = radecToPixel(wcs, raDeg, decDeg);
    const majEnd = endpoint(majArcmin / 2, paRad);
    const minEnd = endpoint(minArcmin / 2, paRad + Math.PI / 2);
    return {
      cx: center.x,
      cy: center.y,
      widthPx: Math.hypot(majEnd.x - center.x, majEnd.y - center.y) * 2,
      heightPx: Math.hypot(minEnd.x - center.x, minEnd.y - center.y) * 2,
      angleDeg: (Math.atan2(majEnd.y - center.y, majEnd.x - center.x) * 180) / Math.PI,
    };
  }

  // -- Label auto-layout engine (verbatim port of DeepSkyMarkerSlider's
  // layoutLabels/leaderGeometry, operating on '.at-marker' elements in
  // '#at-frame' instead of '.dsm-marker'/'​.dsm-frame'). --
  function rectCircleOverlap(left, top, w, h, cx, cy, r) {
    const closestX = Math.max(left, Math.min(cx, left + w));
    const closestY = Math.max(top, Math.min(cy, top + h));
    const dx = cx - closestX;
    const dy = cy - closestY;
    return dx * dx + dy * dy < r * r;
  }
  function rectsOverlap(a, b) {
    return !(a.left + a.w < b.left || b.left + b.w < a.left || a.top + a.h < b.top || b.top + b.h < a.top);
  }
  function overlapArea(a, b) {
    const ox = Math.max(0, Math.min(a.left + a.w, b.left + b.w) - Math.max(a.left, b.left));
    const oy = Math.max(0, Math.min(a.top + a.h, b.top + b.h) - Math.max(a.top, b.top));
    return ox * oy;
  }
  function segPointDist(x1, y1, x2, y2, px, py) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const lenSq = dx * dx + dy * dy;
    let t = lenSq === 0 ? 0 : ((px - x1) * dx + (py - y1) * dy) / lenSq;
    t = Math.max(0, Math.min(1, t));
    const cx = x1 + t * dx;
    const cy = y1 + t * dy;
    return Math.hypot(px - cx, py - cy);
  }

  // Dragging a slider (or moving several at once) can fire many visibility
  // changes in quick succession -- debounce so a fast drag doesn't run the
  // full collision-avoidance pass on every intermediate value.
  let layoutTimer;
  function scheduleLayout() {
    window.clearTimeout(layoutTimer);
    layoutTimer = window.setTimeout(() => layoutLabels(), 60);
  }

  function layoutLabels() {
    const frame = document.getElementById('at-frame');
    // Only markers a currently-active slider actually reveals should act as
    // placement obstacles -- a page can accumulate hundreds of markers
    // across all fetched categories (e.g. 700+ stars) that stay hidden
    // until their slider is pulled down. Including hidden ones here was
    // forcing visible labels to dodge phantom dots nobody can see, which is
    // what produced needlessly long leader lines into open space.
    const markerEls = Array.from(document.querySelectorAll('.at-marker[data-visible="true"]'));
    if (!frame || !markerEls.length) return;

    markerEls.forEach((m) => m.classList.add('at-measuring'));
    void frame.offsetWidth;

    const frameRect = frame.getBoundingClientRect();
    const items = markerEls.map((m) => {
      const dot = m.querySelector('.at-dot');
      const tag = m.querySelector('.at-tag');
      const leader = m.querySelector('.at-leader');
      tag.style.transform = '';
      const dr = dot.getBoundingClientRect();
      const tr = tag.getBoundingClientRect();
      return {
        tag,
        leader,
        ringX: dr.x + dr.width / 2 - frameRect.x,
        ringY: dr.y + dr.height / 2 - frameRect.y,
        natLeft: tr.x - frameRect.x,
        natTop: tr.y - frameRect.y,
        w: tr.width,
        h: tr.height,
        mag: m.dataset.mag ? parseFloat(m.dataset.mag) : Infinity,
        hasName: m.dataset.hasName === '1',
      };
    });

    // Whoever gets placed first claims the closest/cleanest spot to their
    // own target, so process brightest-first (fainter/extended objects with
    // no photometry sort last), then named objects ahead of unnamed ones at
    // the same brightness, then point sources ahead of extended objects --
    // matches Jay's stated relocation priority (2026-08-01).
    items.sort((a, b) => {
      if (a.mag !== b.mag) return a.mag - b.mag;
      if (a.hasName !== b.hasName) return a.hasName ? -1 : 1;
      return 0;
    });

    const placed = [];

    function ringClear(left, top, w, h) {
      for (let j = 0; j < items.length; j++) {
        if (rectCircleOverlap(left, top, w, h, items[j].ringX, items[j].ringY, RING_EXCLUDE)) return false;
      }
      return true;
    }
    function inBounds(left, top, w, h) {
      return left >= EDGE_MARGIN && top >= EDGE_MARGIN && left + w <= frameRect.width - EDGE_MARGIN && top + h <= frameRect.height - EDGE_MARGIN;
    }
    function crossingPenalty(ringX, ringY, cx, cy, selfIndex) {
      let crossings = 0;
      for (let j = 0; j < items.length; j++) {
        if (j === selfIndex) continue;
        if (segPointDist(ringX, ringY, cx, cy, items[j].ringX, items[j].ringY) < RING_EXCLUDE) crossings++;
      }
      return crossings;
    }

    items.forEach((item, i) => {
      let best = null;

      if (!best) {
        for (const radius of SEARCH_RADII) {
          let foundAtRadius = null;
          let foundScore = Infinity;
          for (let a = 0; a < SEARCH_ANGLES; a++) {
            const angle = (a / SEARCH_ANGLES) * Math.PI * 2;
            const cx = item.ringX + radius * Math.cos(angle);
            const cy = item.ringY + radius * Math.sin(angle);
            const left = cx - item.w / 2;
            const top = cy - item.h / 2;
            if (!inBounds(left, top, item.w, item.h)) continue;
            if (!ringClear(left, top, item.w, item.h)) continue;
            const box = { left, top, w: item.w, h: item.h };
            if (placed.some((p) => rectsOverlap(box, p))) continue;
            const score = crossingPenalty(item.ringX, item.ringY, cx, cy, i) * 40;
            if (score < foundScore) {
              foundScore = score;
              foundAtRadius = { cx, cy, left, top };
            }
          }
          if (foundAtRadius) {
            best = foundAtRadius;
            break;
          }
        }
      }

      if (!best) {
        let bestScore = Infinity;
        for (const radius of SEARCH_RADII) {
          for (let a = 0; a < SEARCH_ANGLES; a++) {
            const angle = (a / SEARCH_ANGLES) * Math.PI * 2;
            const cx = item.ringX + radius * Math.cos(angle);
            const cy = item.ringY + radius * Math.sin(angle);
            const left = cx - item.w / 2;
            const top = cy - item.h / 2;
            if (!inBounds(left, top, item.w, item.h)) continue;
            if (!ringClear(left, top, item.w, item.h)) continue;
            const box = { left, top, w: item.w, h: item.h };
            const overlap = placed.reduce((sum, p) => sum + overlapArea(box, p), 0);
            const score = radius + overlap * 3;
            if (score < bestScore) {
              bestScore = score;
              best = { cx, cy, left, top };
            }
          }
        }
      }

      if (!best) {
        const cx = item.ringX;
        let left = cx - item.w / 2;
        let top = item.ringY + TAG_DEFAULT_Y;
        // True last resort (no legal, overlap-minimized spot found at any
        // search radius) -- still must not push the box past the frame
        // edge, so clamp into bounds rather than skipping the check.
        left = Math.max(EDGE_MARGIN, Math.min(left, frameRect.width - EDGE_MARGIN - item.w));
        top = Math.max(EDGE_MARGIN, Math.min(top, frameRect.height - EDGE_MARGIN - item.h));
        best = { cx: left + item.w / 2, cy: top + item.h / 2, left, top };
      }

      placed.push({ left: best.left, top: best.top, w: item.w, h: item.h });

      const dx = best.cx - (item.natLeft + item.w / 2);
      const dy = best.cy - (item.natTop + item.h / 2);
      item.tag.style.transform = `translate(${dx}px, ${dy}px)`;
      item.tag.dataset.offsetX = String(dx);
      item.tag.dataset.offsetY = String(dy);

      const targetX = dx;
      const targetY = TAG_DEFAULT_Y + dy;
      const anchorX = dx !== 0 ? Math.sign(dx) * RING_RADIUS : 0;
      const anchorY = dx !== 0 ? 0 : RING_RADIUS;
      const vx = targetX - anchorX;
      const vy = targetY - anchorY;
      const length = Math.sqrt(vx * vx + vy * vy);
      const angleDeg = (Math.atan2(-vx, vy) * 180) / Math.PI;
      item.leader.style.left = `calc(50% + ${anchorX}px)`;
      item.leader.style.top = `${anchorY}px`;
      item.leader.style.height = `${length.toFixed(2)}px`;
      item.leader.style.transform = `translate(-50%, 0) rotate(${angleDeg.toFixed(2)}deg)`;
    });

    markerEls.forEach((m) => m.classList.remove('at-measuring'));
  }

  // ---------------------------------------------------------------------
  // Page wiring
  // ---------------------------------------------------------------------
  const fileInput = document.getElementById('at-file-input');
  const uploadBtn = document.getElementById('at-upload-btn');
  const frameWrap = document.getElementById('at-frame-wrap');
  const frame = document.getElementById('at-frame');
  const previewImg = document.getElementById('at-preview-img');
  const solvePanel = document.getElementById('at-solve-panel');
  const solveBtn = document.getElementById('at-solve-btn');
  const solveStatus = document.getElementById('at-solve-status');
  const categoriesPanel = document.getElementById('at-categories');
  const categoryStatus = document.getElementById('at-category-status');
  const slidersPanel = document.getElementById('at-sliders-panel');
  const slidersContainer = document.getElementById('at-sliders');
  const resetSlidersBtn = document.getElementById('at-reset-sliders-btn');
  const infoBar = document.getElementById('at-info-bar');
  const downloadBtn = document.getElementById('at-download-btn');
  const specResolution = document.getElementById('at-spec-resolution');
  const specScale = document.getElementById('at-spec-scale');
  const specFov = document.getElementById('at-spec-fov');
  const specCenter = document.getElementById('at-spec-center');

  let uploadedFile = null;
  let wcs = null; // { CRVAL1, CRVAL2, CRPIX1, CRPIX2, CD1_1, CD1_2, CD2_1, CD2_2, IMAGEW, IMAGEH }
  let fieldCenter = null; // { ra, dec, radiusDeg }
  const activeCategories = new Set();

  uploadBtn.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', () => {
    const file = fileInput.files && fileInput.files[0];
    if (!file) return;
    uploadedFile = file;
    wcs = null;
    fieldCenter = null;
    activeCategories.clear();
    slidersContainer.innerHTML = '';
    document.querySelectorAll('.at-marker, .at-outline').forEach((m) => m.remove());
    categoriesPanel.hidden = true;
    solveStatus.textContent = '';

    const url = URL.createObjectURL(file);
    previewImg.src = url;
    frameWrap.hidden = false;
    solvePanel.hidden = false;
    infoBar.hidden = false;
    specResolution.textContent = '—';
    specScale.textContent = '—';
    specFov.textContent = '—';
    specCenter.textContent = '—';
    solveBtn.disabled = false;
    solveBtn.textContent = 'Plate-solve this image';
  });

  async function pollStatus(subid) {
    for (;;) {
      await new Promise((r) => setTimeout(r, 4000));
      const res = await fetch(`${WORKER_URL}/solve/status?subid=${encodeURIComponent(subid)}`);
      const data = await res.json();
      if (data.status === 'solved') return data.jobId;
      if (data.status === 'failed') throw new Error('Plate-solve failed -- try a clearer/wider-field image.');
      solveStatus.textContent = data.status === 'submitted' ? 'Queued…' : 'Solving…';
    }
  }

  solveBtn.addEventListener('click', async () => {
    if (!uploadedFile) return;
    solveBtn.disabled = true;
    solveStatus.textContent = 'Uploading…';
    try {
      const form = new FormData();
      form.set('file', uploadedFile);
      const uploadRes = await fetch(`${WORKER_URL}/solve/upload`, { method: 'POST', body: form });
      const uploadData = await uploadRes.json();
      if (uploadData.error) throw new Error(uploadData.error);

      solveStatus.textContent = 'Queued…';
      const jobId = await pollStatus(uploadData.subid);

      solveStatus.textContent = 'Fetching solution…';
      const wcsRes = await fetch(`${WORKER_URL}/solve/wcs?jobId=${encodeURIComponent(jobId)}`);
      const wcsData = await wcsRes.json();
      if (wcsData.error) throw new Error(wcsData.error);
      wcs = wcsData;

      const scaleX = Math.hypot(wcs.CD1_1, wcs.CD2_1);
      const scaleY = Math.hypot(wcs.CD1_2, wcs.CD2_2);
      const fovW = scaleX * wcs.IMAGEW;
      const fovH = scaleY * wcs.IMAGEH;
      // The half-diagonal is the farthest any point in the *undistorted*
      // linear-CD-matrix rectangle can be from center, but a real photo's
      // true sky coverage (once SIP distortion is accounted for, see
      // radecToPixel above) commonly runs a bit larger at the edges than
      // that flat estimate -- confirmed live 2026-08-01: a real edge
      // object needed a search radius ~10-15% past the plain half-diagonal
      // before SIMBAD's cone search would even return it as a candidate.
      // A generous cushion here is cheap (MAX_RADIUS_DEG caps it, and the
      // in-frame pixel check below still correctly excludes anything
      // that's actually outside the photo).
      fieldCenter = {
        ra: wcs.CRVAL1,
        dec: wcs.CRVAL2,
        radiusDeg: (Math.sqrt(fovW * fovW + fovH * fovH) / 2) * 1.18,
      };

      const pixelScaleArcsec = ((scaleX + scaleY) / 2) * 3600;
      specResolution.textContent = `${wcs.IMAGEW} × ${wcs.IMAGEH} px`;
      specScale.textContent = `${pixelScaleArcsec.toFixed(2)}"/px`;
      specFov.textContent = `${formatDegArcmin(fovW)} × ${formatDegArcmin(fovH)} (${fovW.toFixed(3)}° × ${fovH.toFixed(3)}°)`;
      specCenter.textContent = formatRaDec(fieldCenter.ra, fieldCenter.dec);

      solveStatus.textContent = 'Solved! Add a slider below to start labeling.';
      solveBtn.textContent = 'Solved';
      categoriesPanel.hidden = false;
    } catch (err) {
      solveStatus.textContent = err instanceof Error ? err.message : 'Something went wrong.';
      solveBtn.disabled = false;
      solveBtn.textContent = 'Plate-solve this image';
    }
  });

  function bucketOf(mag) {
    return Math.ceil(mag - 1e-9);
  }

  // A single real object can satisfy more than one active slider at once
  // -- e.g. M42 matches both "HII Regions" (by otype) and "Messier" (by
  // catalog). Rather than render two overlapping rings/tags for the same
  // object, each marker tracks EVERY category that claims it (`categories`
  // set, mirrored into the `data-category` attribute as a space-separated
  // list so `[data-category~="x"]` selectors keep working) plus a
  // per-category bucket and visibility flag -- a shared marker must stay
  // visible if ANY of its owning sliders currently reveals it, not just
  // the most-recently-adjusted one.
  function syncVisible(marker) {
    const anyVisible = Object.values(marker._visible).some(Boolean);
    if (anyVisible) {
      marker.setAttribute('data-visible', 'true');
      if (marker._outlineEl) marker._outlineEl.setAttribute('data-visible', 'true');
    } else {
      marker.removeAttribute('data-visible');
      if (marker._outlineEl) marker._outlineEl.removeAttribute('data-visible');
    }
  }

  function findExistingMarker(name) {
    return frame.querySelector(`.at-marker[data-name="${CSS.escape(name)}"]`);
  }

  function mergeCategoryIntoMarker(marker, category, bucket) {
    marker._categories.add(category);
    marker.dataset.category = Array.from(marker._categories).join(' ');
    marker._buckets[category] = bucket;
    marker._visible[category] = false;
  }

  function buildMarkerEl(obj, category, x, y, bucket) {
    const meta = CATEGORY_META[category];
    const marker = document.createElement('span');
    marker.className = 'at-marker';
    marker.dataset.name = obj.name;
    marker._categories = new Set();
    marker._buckets = {};
    marker._visible = {};
    mergeCategoryIntoMarker(marker, category, bucket);
    marker.style.left = `${((x / wcs.IMAGEW) * 100).toFixed(2)}%`;
    marker.style.top = `${((y / wcs.IMAGEH) * 100).toFixed(2)}%`;

    const dot = document.createElement('span');
    dot.className = 'at-dot';

    const leader = document.createElement('span');
    leader.className = 'at-leader';

    const tag = document.createElement('span');
    tag.className = 'at-tag';
    const nameEl = document.createElement('strong');
    // Where SIMBAD has a recognized common name (Sirius, Betelgeuse, ...),
    // show it alongside the catalog designation rather than in place of
    // it -- the designation is still the unambiguous identifier, the name
    // is what most people will actually recognize.
    marker.dataset.mag = obj.mag != null ? String(obj.mag) : '';
    marker.dataset.hasName = obj.commonName ? '1' : '0';
    const displayName = obj.commonName ? `${obj.commonName} (${obj.name})` : obj.name;
    // Observing-list catalogs (Herschel 400/II, Caldwell) get their own
    // list position shown alongside the object's real designation, e.g.
    // "C106 · NGC 104" -- the object's number in that list, not just its
    // NGC/IC name.
    nameEl.textContent = obj.listNumber ? `${obj.listNumber} · ${displayName}` : displayName;
    tag.appendChild(nameEl);
    const kindText = meta.kind || obj.spType || (obj.otype ? OTYPE_LABELS[obj.otype] || obj.otype : null);
    if (kindText) {
      const kindEl = document.createElement('span');
      kindEl.className = 'at-kind';
      kindEl.textContent = kindText;
      tag.appendChild(kindEl);
    }
    // Extended objects (clusters/galaxies/nebulae) frequently have no
    // photometry in SIMBAD at all -- obj.mag is null in that case, so
    // there's no "mag X.X" line to show (matches DeepSkyMarkerSlider's
    // own handling of magnitude-less markers).
    if (obj.mag != null) {
      const magEl = document.createElement('span');
      magEl.className = 'at-mag';
      magEl.textContent = `mag ${obj.mag.toFixed(1)}`;
      tag.appendChild(magEl);
    }

    marker.appendChild(dot);
    marker.appendChild(leader);
    marker.appendChild(tag);
    return marker;
  }

  function buildSliderBlock(category, markerCount, minBucket, maxBucket) {
    const meta = CATEGORY_META[category];
    const block = document.createElement('div');
    block.className = 'at-slider-block';
    block.dataset.category = category;

    const title = document.createElement('p');
    title.className = 'at-slider-title';
    title.textContent = meta.label;
    block.appendChild(title);

    const input = document.createElement('input');
    input.type = 'range';
    input.min = String(minBucket - 1);
    input.max = String(maxBucket);
    input.step = '1';
    input.value = String(minBucket - 1);
    input.setAttribute('aria-label', `Reveal ${meta.label.toLowerCase()} down to this apparent magnitude`);
    block.appendChild(input);

    const readout = document.createElement('div');
    readout.className = 'at-readout';
    const readoutValue = document.createElement('span');
    readoutValue.className = 'at-readout-value';
    readoutValue.textContent = 'Normal image';
    const readoutCount = document.createElement('span');
    readoutCount.className = 'at-readout-count';
    readout.appendChild(readoutValue);
    readout.appendChild(readoutCount);
    block.appendChild(readout);

    const restValue = minBucket - 1;
    function apply() {
      const value = Number(input.value);
      // ~= (not =) since a marker's data-category can hold more than one
      // category once objects are shared across active sliders.
      const markers = document.querySelectorAll(`.at-marker[data-category~="${category}"]`);
      if (value <= restValue) {
        markers.forEach((m) => {
          m._visible[category] = false;
          syncVisible(m);
        });
        readoutValue.textContent = 'Normal image';
        readoutCount.textContent = '';
        return;
      }
      let shown = 0;
      markers.forEach((m) => {
        const bucket = m._buckets[category];
        m._visible[category] = bucket <= value;
        if (m._visible[category]) shown++;
        syncVisible(m);
      });
      readoutValue.textContent = `Down to magnitude ${value}`;
      readoutCount.textContent = `${shown} labeled`;
      scheduleLayout();
    }
    input.addEventListener('input', apply);
    apply();

    return block;
  }

  const SPARSE_RETRY_MAGLIMIT = 18;
  const SPARSE_THRESHOLD = 2;

  // A hard 0..IMAGEW/IMAGEH cutoff clips real, visually-in-frame objects
  // sitting right at the edge -- the astrometry.net WCS solution is a fit,
  // not exact, and a couple of arcsec of residual error is normal. Reported
  // live (2026-08-01): M91 and NGC 4571, both genuinely visible near the
  // top edge of a Markarian's Chain photo, were silently dropped by this
  // check even though the worker's own cone search returned them. A small
  // tolerance margin (2% of each dimension) keeps near-edge objects that
  // are actually in the photo without pulling in genuinely-outside ones.
  const EDGE_TOLERANCE_FRAC = 0.02;

  // Debug aid: every fetch's raw SIMBAD rows plus which ones got excluded
  // by the frame bounds check, keyed by category -- lets a "why isn't X
  // showing up" report be diagnosed directly from devtools (or by reading
  // this out of the live page) instead of guessing at WCS math blind.
  window.__atDebug = {};

  async function fetchCategoryRows(category, maglimit) {
    const url = `${WORKER_URL}/simbad/cone?ra=${fieldCenter.ra}&dec=${fieldCenter.dec}&radiusDeg=${fieldCenter.radiusDeg}&category=${category}&maglimit=${maglimit}`;
    const res = await fetch(url);
    const rows = await res.json();
    if (rows.error) throw new Error(rows.error);
    // Only rows that actually land inside the frame (plus a small edge
    // tolerance, see above) count toward "sparse" -- a cone search can
    // return plenty of raw rows that fall well outside the rectangular
    // image.
    const marginX = wcs.IMAGEW * EDGE_TOLERANCE_FRAC;
    const marginY = wcs.IMAGEH * EDGE_TOLERANCE_FRAC;
    const withPixels = rows.map((obj) => ({ obj, ...radecToPixel(wcs, obj.ra, obj.dec) }));
    const inFrame = [];
    const excluded = [];
    for (const r of withPixels) {
      const ok = r.x >= -marginX && r.x <= wcs.IMAGEW + marginX && r.y >= -marginY && r.y <= wcs.IMAGEH + marginY;
      (ok ? inFrame : excluded).push({ name: r.obj.name, ra: r.obj.ra, dec: r.obj.dec, x: r.x, y: r.y });
    }
    window.__atDebug[category] = { imagew: wcs.IMAGEW, imageh: wcs.IMAGEH, marginX, marginY, inFrame, excluded };
    return inFrame.map((r) => rows.find((o) => o.name === r.name));
  }

  async function addCategorySlider(category) {
    if (!wcs || !fieldCenter || activeCategories.has(category)) return;
    activeCategories.add(category);
    const btn = document.querySelector(`.at-category-buttons button[data-category="${category}"]`);
    if (btn) btn.disabled = true;
    categoryStatus.textContent = `Looking up ${CATEGORY_META[category].label.toLowerCase()}…`;

    try {
      const meta = CATEGORY_META[category];
      let rows = await fetchCategoryRows(category, meta.maglimit);
      // A field that's genuinely sparse in this category (e.g. only 1-2
      // Caldwell objects visible) is worth digging deeper for -- retry at
      // a much deeper cutoff rather than leaving the slider nearly empty.
      if (rows.length <= SPARSE_THRESHOLD && meta.maglimit < SPARSE_RETRY_MAGLIMIT) {
        categoryStatus.textContent = `Only ${rows.length} found at first pass -- looking deeper…`;
        const deeper = await fetchCategoryRows(category, SPARSE_RETRY_MAGLIMIT);
        if (deeper.length > rows.length) rows = deeper;
      }

      let added = 0;
      let minBucket = Infinity;
      let maxBucket = -Infinity;
      for (const obj of rows) {
        const { x, y } = radecToPixel(wcs, obj.ra, obj.dec);
        // No real magnitude on file for this object (common for extended
        // objects like clusters/galaxies) -- fall back to the category's
        // own mag limit so it still gets a defined reveal position instead
        // of being silently dropped.
        const bucket = obj.mag != null ? bucketOf(obj.mag) : meta.maglimit;
        // The same real object can satisfy more than one active category
        // (e.g. M42 matches both "HII Regions" and "Messier") -- merge
        // into the existing ring/tag instead of stacking a duplicate on
        // top of it.
        const existing = findExistingMarker(obj.name);
        if (existing) {
          mergeCategoryIntoMarker(existing, category, bucket);
        } else {
          const marker = buildMarkerEl(obj, category, x, y, bucket);
          frame.appendChild(marker);
          if (obj.outline) {
            const geo = outlineEllipsePixels(wcs, obj.ra, obj.dec, obj.outline.majAxisArcmin, obj.outline.minAxisArcmin, obj.outline.angleDeg);
            const outlineEl = document.createElement('span');
            outlineEl.className = 'at-outline';
            outlineEl.dataset.name = obj.name;
            outlineEl.style.left = `${(geo.cx / wcs.IMAGEW) * 100}%`;
            outlineEl.style.top = `${(geo.cy / wcs.IMAGEH) * 100}%`;
            outlineEl.style.width = `${(geo.widthPx / wcs.IMAGEW) * 100}%`;
            outlineEl.style.height = `${(geo.heightPx / wcs.IMAGEH) * 100}%`;
            outlineEl.style.transform = `translate(-50%, -50%) rotate(${geo.angleDeg.toFixed(2)}deg)`;
            frame.appendChild(outlineEl);
            marker._outlineEl = outlineEl;
          }
        }
        minBucket = Math.min(minBucket, bucket);
        maxBucket = Math.max(maxBucket, bucket);
        added++;
      }

      if (added === 0) {
        categoryStatus.textContent = `No ${CATEGORY_META[category].label.toLowerCase()} found in this field.`;
        activeCategories.delete(category);
        if (btn) btn.disabled = false;
        return;
      }

      const block = buildSliderBlock(category, added, minBucket, maxBucket);
      slidersContainer.appendChild(block);
      slidersPanel.hidden = false;
      categoryStatus.textContent = `Added ${added} ${CATEGORY_META[category].label.toLowerCase()}.`;
      layoutLabels();
    } catch (err) {
      categoryStatus.textContent = err instanceof Error ? err.message : 'Lookup failed.';
      activeCategories.delete(category);
      if (btn) btn.disabled = false;
    }
  }

  document.querySelectorAll('.at-category-buttons button').forEach((btn) => {
    btn.addEventListener('click', () => addCategorySlider(btn.dataset.category));
  });

  // Clears every active slider/marker while leaving the uploaded image and
  // its plate-solve (wcs/fieldCenter) untouched, so re-adding sliders
  // afterward doesn't require re-uploading or re-solving.
  resetSlidersBtn.addEventListener('click', () => {
    document.querySelectorAll('.at-marker, .at-outline').forEach((m) => m.remove());
    slidersContainer.innerHTML = '';
    slidersPanel.hidden = true;
    activeCategories.clear();
    document.querySelectorAll('.at-category-buttons button').forEach((btn) => {
      btn.disabled = false;
    });
    categoryStatus.textContent = '';
  });

  window.addEventListener('resize', scheduleLayout);

  // ---------------------------------------------------------------------
  // Download: composite the base image + every currently-visible marker
  // onto a canvas at the image's native resolution, scaling ring/leader/
  // text sizes up from their on-screen CSS-pixel sizes by the same ratio
  // as native-width/displayed-width, so the export looks proportionally
  // identical to what's on screen.
  // ---------------------------------------------------------------------
  function drawRoundedRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  downloadBtn.addEventListener('click', () => {
    const naturalWidth = previewImg.naturalWidth;
    const naturalHeight = previewImg.naturalHeight;
    if (!naturalWidth || !naturalHeight) return;

    const displayWidth = frame.getBoundingClientRect().width;
    const scale = naturalWidth / displayWidth;

    const canvas = document.createElement('canvas');
    canvas.width = naturalWidth;
    canvas.height = naturalHeight;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(previewImg, 0, 0, naturalWidth, naturalHeight);

    const ringRadius = RING_RADIUS * scale;
    const nameFontPx = 11 * scale;
    const smallFontPx = 10 * scale;
    const lineHeight = 13 * scale;
    const padX = 5 * scale;
    const padY = 3 * scale;

    document.querySelectorAll('.at-outline[data-visible="true"]').forEach((el) => {
      const cx = (parseFloat(el.style.left) / 100) * naturalWidth;
      const cy = (parseFloat(el.style.top) / 100) * naturalHeight;
      const w = (parseFloat(el.style.width) / 100) * naturalWidth;
      const h = (parseFloat(el.style.height) / 100) * naturalHeight;
      const rotMatch = /rotate\(([-\d.]+)deg\)/.exec(el.style.transform);
      const rotDeg = rotMatch ? Number(rotMatch[1]) : 0;
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate((rotDeg * Math.PI) / 180);
      ctx.setLineDash([6 * scale, 5 * scale]);
      ctx.strokeStyle = 'rgba(255,213,74,0.5)';
      ctx.lineWidth = Math.max(1, scale);
      ctx.beginPath();
      ctx.ellipse(0, 0, w / 2, h / 2, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    });

    document.querySelectorAll('.at-marker[data-visible="true"]').forEach((m) => {
      const leftPct = parseFloat(m.style.left) / 100;
      const topPct = parseFloat(m.style.top) / 100;
      const ringX = leftPct * naturalWidth;
      const ringY = topPct * naturalHeight;

      const tag = m.querySelector('.at-tag');
      const offsetX = (Number(tag.dataset.offsetX) || 0) * scale;
      const offsetY = (Number(tag.dataset.offsetY) || 0) * scale;

      // Ring
      ctx.beginPath();
      ctx.arc(ringX, ringY, ringRadius, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(0,0,0,0.85)';
      ctx.lineWidth = ringRadius * 0.5;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(ringX, ringY, ringRadius, 0, Math.PI * 2);
      ctx.strokeStyle = '#ffd54a';
      ctx.lineWidth = ringRadius * 0.3;
      ctx.stroke();

      // Tag text lines
      const nameLine = tag.querySelector('strong')?.textContent || '';
      const kindLine = tag.querySelector('.at-kind')?.textContent || '';
      const magLine = tag.querySelector('.at-mag')?.textContent || '';
      const lines = [nameLine, kindLine, magLine].filter(Boolean);

      ctx.font = `bold ${nameFontPx}px sans-serif`;
      const widths = lines.map((line, i) => {
        ctx.font = i === 0 ? `bold ${nameFontPx}px sans-serif` : `${smallFontPx}px sans-serif`;
        return ctx.measureText(line).width;
      });
      const tagW = Math.max(...widths) + padX * 2;
      const tagH = lines.length * lineHeight + padY * 2;
      const tagCenterX = ringX + offsetX;
      const tagCenterY = ringY + TAG_DEFAULT_Y * scale + offsetY + tagH / 2 - lineHeight / 2;
      const tagLeft = tagCenterX - tagW / 2;
      const tagTop = tagCenterY - tagH / 2;

      // Leader line: from ring edge to tag top-center.
      const dx = tagCenterX - ringX;
      const dy = tagTop - ringY;
      const len = Math.hypot(dx, dy);
      if (len > 0) {
        const ux = dx / len;
        const uy = dy / len;
        ctx.beginPath();
        ctx.moveTo(ringX + ux * ringRadius, ringY + uy * ringRadius);
        ctx.lineTo(tagCenterX, tagTop);
        ctx.strokeStyle = 'rgba(255,213,74,0.85)';
        ctx.lineWidth = Math.max(1, scale);
        ctx.stroke();
      }

      // Tag background
      ctx.fillStyle = 'rgba(0,0,0,0.78)';
      drawRoundedRect(ctx, tagLeft, tagTop, tagW, tagH, 3 * scale);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,213,74,0.55)';
      ctx.lineWidth = Math.max(1, scale * 0.5);
      ctx.stroke();

      // Tag text
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      lines.forEach((line, i) => {
        const isName = i === 0;
        ctx.font = isName ? `bold ${nameFontPx}px sans-serif` : `${smallFontPx}px sans-serif`;
        ctx.fillStyle = i === lines.length - 1 && magLine ? '#ffd54a' : isName ? '#fff' : 'rgba(255,255,255,0.75)';
        ctx.fillText(line, tagCenterX, tagTop + padY + lineHeight * i + lineHeight / 2);
      });
    });

    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'labeled-astrophoto.png';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }, 'image/png');
  });
</script>
