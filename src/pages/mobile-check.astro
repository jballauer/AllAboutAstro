---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mobile Check"
  description="A diagnostic page reporting the real type and viewport measurements this device produces."
  noindex={true}
>
  <h1 class="mc-h1">Mobile Check</h1>

  <!-- The readout comes FIRST and is sized to fit one phone screen: this
       page exists to be screenshotted, and anything above it just pushes
       the numbers out of frame. -->
  <div id="mc-out" class="mc-out">Measuring&hellip;</div>

  <p><button type="button" id="mc-refresh">Re-measure</button></p>

  <!-- The stand-in samples above can disagree with a real article, so the
       diagnostic loads one for real and measures inside it. -->
  <h2 class="mc-h2">Measured inside a real article</h2>
  <div id="mc-frame-out" class="mc-out">Loading the article&hellip;</div>
  <div class="mc-frame-wrap">
  <iframe
    id="mc-frame"
    class="mc-frame"
    src="/learning/where-to-setup-your-telescope/"
    title="Where to Setup Your Telescope, loaded for measurement"
    loading="eager"
  ></iframe>
  </div>

  <p class="mc-note">
    Every number above is measured live on <em>this</em> device, not assumed.
    Rotate to landscape and send a screenshot.
  </p>

  <!-- Two sample blocks the script measures. They deliberately carry no
       font-size of their own, exactly like real article prose, so whatever
       the browser does to body text it does to these too. -->
  <div class="mc-samples" aria-hidden="true">
    <p class="mc-body-sample">
      Body sample. Kellner eyepieces came standard with many of the older
      instruments, and the difference in contrast is obvious once you have
      compared them side by side on a night of steady seeing.
    </p>
    <div class="ke-sidebar" data-side="right" data-width="wide">
      <h2>Sidebar Sample</h2>
      <p>
        Sidebar sample text. This paragraph sits inside a real
        <code>.ke-sidebar</code>, so it picks up exactly the same rules a
        chapter sidebar would.
      </p>
    </div>
    <div class="ke-clear"></div>
  </div>
</BaseLayout>

<style>
  .mc-h1 {
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }
  .mc-note {
    font-size: 0.9rem;
    opacity: 0.8;
  }
  .mc-out {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    /* Small enough that the whole readout fits one phone screen. */
    font-size: 0.72rem;
    line-height: 1.45;
    background: #12151d;
    border: 1px solid #2a2f3a;
    border-radius: 6px;
    padding: 1rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  /* In landscape there is height to spare only if the readout stops being
     one tall column — two columns keep the whole thing inside a single
     screenshot. */
  @media (min-width: 600px) {
    .mc-out {
      columns: 2;
      column-gap: 2rem;
    }
  }
  #mc-refresh {
    font: inherit;
    padding: 0.6rem 1rem;
    min-height: 44px;
    background: #1d5f8a;
    color: #fff;
    border: 0;
    border-radius: 6px;
  }
  .mc-frame-wrap {
    overflow-x: auto;
  }
  .mc-h2 {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.6rem;
  }
  /* Tall enough that the article inside lays out as it really would, and
     wide enough to share this page's column width so any width-dependent
     text inflation behaves the same way. */
  .mc-frame {
    /* A percentage width makes the framed article render ~50px narrower
       than the real viewport, which lands it on the wrong side of a
       breakpoint.  Pinned to 750 (an iPhone in landscape) so the article
       inside sees the same width it really does; the wrapper scrolls if
       the screen is narrower. */
    width: 750px;
    max-width: none;
    height: 420px;
    border: 1px solid #2a2f3a;
    border-radius: 6px;
    margin-top: 0.75rem;
  }
  .mc-samples {
    margin-top: 2rem;
    opacity: 0.55;
  }
</style>

<script>
  const out = document.getElementById('mc-out');
  const bodySample = document.querySelector('.mc-body-sample');
  const sidebarSample = document.querySelector('.mc-samples .ke-sidebar');

  const px = (el, prop) => (el ? getComputedStyle(el)[prop] : 'n/a');
  const num = (v) => parseFloat(v) || 0;

  const measure = () => {
    const html = document.documentElement;
    // A probe with no styling at all: whatever this computes to IS the
    // browser's effective base font size on this device.
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;';
    document.body.appendChild(probe);
    const base = getComputedStyle(probe).fontSize;
    probe.remove();

    // getComputedStyle reports the AUTHORED font-size, so it cannot see iOS
    // Safari's text autosizing at all — that inflates the painted text and
    // leaves the computed value alone.  These probes measure RENDERED
    // geometry instead: a single line at font-size 16px / line-height 1 is
    // 16px tall unless the browser is boosting it.
    const boostProbe = (width) => {
      const box = document.createElement('div');
      box.style.cssText =
        'position:absolute;left:-9999px;top:0;font-size:16px;line-height:1;' +
        'font-family:var(--font-body);width:' + width + 'px;';
      box.textContent = 'M';
      document.body.appendChild(box);
      const h = box.getBoundingClientRect().height;
      box.remove();
      return h;
    };
    const narrowBoost = boostProbe(250);
    const wideBoost = boostProbe(700);
    const boosted = narrowBoost > 16.8 || wideBoost > 16.8;

    const sidebarP = sidebarSample ? sidebarSample.querySelector('p') : null;
    const bodyPx = num(px(bodySample, 'fontSize'));
    const sidePx = num(px(sidebarP, 'fontSize'));

    // Which build is actually being served — the rem fix landed in a bundle
    // whose --font-body-size is a rem value, not 14px.
    const varValue = getComputedStyle(html).getPropertyValue('--font-body-size').trim();

    const lines = [
      'VIEWPORT',
      '  innerWidth        ' + window.innerWidth,
      '  clientWidth       ' + html.clientWidth,
      '  orientation       ' + (window.innerWidth > window.innerHeight ? 'landscape' : 'portrait'),
      '  devicePixelRatio  ' + window.devicePixelRatio,
      '  visualViewport    ' + (window.visualViewport
        ? Math.round(window.visualViewport.width) + ' @ scale ' + window.visualViewport.scale.toFixed(2)
        : 'n/a'),
      '',
      'TYPE',
      '  base font size    ' + base,
      '  --font-body-size  ' + (varValue || '(unset)'),
      '  body sample       ' + px(bodySample, 'fontSize') + '  / line ' + px(bodySample, 'lineHeight'),
      '  sidebar sample    ' + px(sidebarP, 'fontSize') + '  / line ' + px(sidebarP, 'lineHeight'),
      '  RATIO body:side   ' + (sidePx ? (bodyPx / sidePx).toFixed(2) : 'n/a') + '   (expected 1.14)',
      '',
      'RENDERED (catches boosting computed style hides)',
      '  16px in 250px col ' + narrowBoost.toFixed(1) + 'px tall  (16.0 = not boosted)',
      '  16px in 700px col ' + wideBoost.toFixed(1) + 'px tall  (16.0 = not boosted)',
      '  VERDICT           ' + (boosted ? '*** TEXT IS BEING BOOSTED ***' : 'no boosting'),
      '',
      'LAYOUT',
      '  sidebar float     ' + px(sidebarSample, 'float'),
      '  sidebar width     ' + Math.round(sidebarSample.getBoundingClientRect().width) + 'px',
      '  matches <=700px   ' + window.matchMedia('(max-width: 700px)').matches,
      '  text-size-adjust  ' + (getComputedStyle(html).webkitTextSizeAdjust
        || getComputedStyle(html).textSizeAdjust || '(unset)'),
      '',
      'BROWSER',
      '  ' + navigator.userAgent,
    ];

    out.textContent = lines.join('\n');
  };

  // Same-origin, so the article's own computed and rendered sizes can be
  // read directly out of the frame — no interpretation needed from whoever
  // is holding the phone.
  const measureFrame = () => {
    const frameOut = document.getElementById('mc-frame-out');
    const frame = document.getElementById('mc-frame');
    let doc;
    try {
      doc = frame.contentDocument;
    } catch (err) {
      frameOut.textContent = 'Could not read the article frame.';
      return;
    }
    if (!doc || !doc.querySelector('article')) {
      frameOut.textContent = 'Article frame not ready — tap Re-measure.';
      return;
    }

    const article = doc.querySelector('article');
    const prose = Array.from(article.querySelectorAll('p')).find(
      (p) => !p.closest('.ke-sidebar') && !p.closest('.ke-figure') && p.textContent.trim().length > 120
    );
    const sidebarP = article.querySelector('.ke-sidebar p');

    // Same rendered-geometry probe, but inside the article's own document.
    const probe = doc.createElement('div');
    probe.style.cssText =
      'position:absolute;left:-9999px;top:0;font-size:16px;line-height:1;width:250px;';
    probe.textContent = 'M';
    doc.body.appendChild(probe);
    const probeH = probe.getBoundingClientRect().height;
    probe.remove();

    const rendered = (el) => {
      if (!el) return null;
      const lh = parseFloat(doc.defaultView.getComputedStyle(el).lineHeight);
      const lines = Math.max(1, Math.round(el.getBoundingClientRect().height / lh));
      return { lines, perLine: Math.round(el.textContent.trim().length / lines) };
    };
    const proseR = rendered(prose);
    const sideR = rendered(sidebarP);
    const cs = (el) => (el ? doc.defaultView.getComputedStyle(el).fontSize : 'n/a');

    frameOut.textContent = [
      'ARTICLE: Where to Setup Your Telescope',
      '  frame width       ' + Math.round(frame.getBoundingClientRect().width),
      '  css bundle        ' + (doc.querySelector('link[href*="BaseLayout"]')
        ? doc.querySelector('link[href*="BaseLayout"]').getAttribute('href').split('/').pop()
        : '(inline)'),
      '  body prose        ' + cs(prose) + '   ~' + (proseR ? proseR.perLine : '?') + ' chars/line',
      '  sidebar prose     ' + cs(sidebarP) + '   ~' + (sideR ? sideR.perLine : '?') + ' chars/line',
      '  boost probe       ' + probeH.toFixed(1) + 'px  (16.0 = not boosted)',
      '  VERDICT           ' + (probeH > 16.8 ? '*** BOOSTED IN THE ARTICLE ***' : 'not boosted'),
    ].join(String.fromCharCode(10));
  };

  measure();
  document.getElementById('mc-frame').addEventListener('load', () => setTimeout(measureFrame, 300));
  document.getElementById('mc-refresh').addEventListener('click', () => {
    measure();
    measureFrame();
  });
  window.addEventListener('resize', measure);
  window.addEventListener('orientationchange', () => setTimeout(measure, 400));
</script>
